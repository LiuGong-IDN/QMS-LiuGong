<div id="idle-timeout-modal" class="modal fade" data-backdrop="static">
    <div class="modal-dialog modal-small">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">Are You Still There ? </h4>
            </div>
            <div class="modal-body">
                For Your Security you will be logout automatically.
                <span id="countdownDisplay"></span>
            </div>
            <div class="modal-footer">
                <button id="idle-timeout-modal-logout" type="button" class="btn dark btn-outline sbold uppercase">"Logout"</button>
                <button id="idle-timeout-modal-keepalive" type="button" class="btn green btn-outline sbold uppercase" data-dismiss="modal">Keep Working"</button>
            </div>
        </div>
    </div>
</div>