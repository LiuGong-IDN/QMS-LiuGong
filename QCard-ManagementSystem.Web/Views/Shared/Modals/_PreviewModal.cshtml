<div id="PreviewModal" class="modal fade bs-modal-lg" abindex="-1" role="dialog" aria-hidden="true" style="display: none;">
    <div class="modal-dialog modal-dialog-centered modal-lg" style="width:1200px">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">Preview Modal</h4>
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="hiddenDataPreview" value="">
                <input type="hidden" id="hiddenDepotCode" value="">
                <div class="text-center">
                    <div id="ViewerContainer"></div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-sm btn-outline-brand btn-square" data-dismiss="modal">Close</button>
