@{
    ApplicationCacheManager.GenerateConfigs();
    var IdleTimeoutLimit = ApplicationCacheManager.GetConfig<int>("IDLE_TIMEOUT_LIMIT", "IDLE_TIMEOUT");
    var IdleTimeoutDisplayLimit = ApplicationCacheManager.GetConfig<int>("IDLE_TIMEOUT_DISPLAY", "IDLE_TIMEOUT");
    var usersession = SessionManager.UserSession;

    var token = string.Empty;
    if (usersession != null)
    {
        token = usersession.Token;
    }
}

