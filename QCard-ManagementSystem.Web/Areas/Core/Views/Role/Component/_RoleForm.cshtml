@model QCard.ManagementSystem.Domain.Modules.Core.Model.Role
<div id="RoleModal" class="modal fade bs-modal-lg" abindex="-1" role="dialog" aria-hidden="true" style="display: none;">
    <div class="modal-dialog" style="min-width: 50%">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title"><label id="modalTitle">Role</label></h4>
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true"></button>
            </div>
            <div class="modal-body">
                <form id="userForm">
                    <input type="hidden" id="ID" data-bind="value: ID" />
                    <div class="form-group">
                        <label>Role Name</label>
                        @Html.TextBoxFor(x => x.ROLE_NAME, new { @class = "form-control", id = "ROLE_NAME_INPUT"})
                        <span class="text-danger id"></span>
                    </div>
                    <div class="form-group">
                        <label>Description</label>
                        @Html.TextAreaFor(x => x.DESCRIPTION, new { @class = "form-control", id = "DESCRIPTION" })
                        <span class="text-danger"></span>
                    </div>
                </form>
                <div class="modal-footer">
                    <button type="button" class="btn btn-reset btn-sm" data-dismiss="modal"><i class="fa fa-times mr-1"></i> Close</button>
                    @* <button type="button" class="btn btn-info btn-sm" id="btnSaveUser">Save</button> *@
                    <button type="button" class="btn blue trigger btn-sm" id="btnSaveRole"><i class="fa fa-save"></i>&nbsp;Save</button>
                    <button type="button" class="btn blue trigger btn-sm" id="btnUpdateRole"><i class="fa fa-save"></i>Update</button>
            </div>
        </div>
    </div>
</div>