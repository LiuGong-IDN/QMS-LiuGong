@model QCard.ManagementSystem.Domain.Modules.Core.ViewModel.ModelView
<div id="ModelModal" class="modal fade bs-modal-lg" abindex="-1" role="dialog" aria-hidden="true" style="display: none;">
    <div class="modal-dialog" style="min-width: 50%">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title"><label id="modalTitle">Model</label></h4>
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true"></button>
            </div>
            <div class="modal-body">
                <form id="modelForm">
                    <input type="hidden" id="ID" data-bind="value: ID" />

                    <div class="form-group row align-items-center mb-2">
                        <label class="col-sm-4 col-form-label fw-bold"><b>Product Model No.</b></label>
                        <div class="col-sm-8">
                            @Html.TextBoxFor(x => x.MODEL_CODE, new { @class = "form-control text-uppercase no-space", id = "MODEL_CODE" })
                            <span class="text-danger id"></span>
                        </div>
                    </div>

                    <div class="form-group row align-items-center mb-2">
                        <label class="col-sm-4 col-form-label fw-bold"><b>Product Model Name</b></label>
                        <div class="col-sm-8">
                            @Html.TextBoxFor(x => x.MODEL_NAME, new { @class = "form-control text-uppercase", id = "MODEL_NAME" })
                            <span class="text-danger id"></span>
                        </div>
                    </div>

                    <div class="form-group row align-items-center mb-2">
                        <label class="col-sm-4 col-form-label fw-bold"><b>Product Group</b></label>
                        <div class="col-sm-8">
                            @Html.TextBoxFor(x => x.ASSET_TYPE_ID, new { @class = "form-control", id = "ASSET_TYPE_ID" })
                            <span class="text-danger id"></span>
                        </div>
                    </div>
                </form>

                <div class="modal-footer">
                    <button type="button" class="btn btn-reset btn-sm" data-dismiss="modal"><i class="fa fa-times mr-1"></i>Close</button>
                    <button type="button" class="btn blue trigger btn-sm" id="btnSaveModel"><i class="fa fa-save"></i>&nbsp;Save</button>
                    <button type="button" class="btn blue trigger btn-sm" id="btnUpdateModel"><i class="fa fa-save"></i>Update</button>
                </div>
            </div>

        </div>
    </div>
</div>

