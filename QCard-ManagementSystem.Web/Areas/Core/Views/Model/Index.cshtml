@using QCard.ManagementSystem.Domain.Modules.Core.ViewModel

@section scripts {
    @Html.Partial("~/Areas/Core/Views/Model/Script/_Model.cshtml")
}

@section modals {
    @Html.Partial("~/Areas/Core/Views/Model/Component/_ModelForm.cshtml")
}

<div class="portlet light margin-bottom-0">
    <div class="row">
        <div class="col-xs-6">
            <div class="page-head">
                <div class="page-title">
                    <h1>
                        <span>Product Model List</span>
                    </h1>
                </div>
            </div>
        </div>
    </div>
    <br />

    <div class="portlet light bordered">
        <div class="portlet-body">
           <form data-grid="ModelGrid" data-filter="true" data-logical-operator="and" method="post">
                @Html.AntiForgeryToken()
                <div class="inputs inputs-full-width">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="modelNameFilter"><b>Product Model Name</b></label>
                                <input id="modelNameFilter" type="text" class="form-control text-uppercase" data-filter='{ "operator": "contains", "field": "MODEL_NAME" }' />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="ASSET_TYPE-FILTER"><b>Product Group</b></label>
                                <input id="ASSET_TYPE-FILTER" name="ASSET_TYPE_ID" class="form-control" data-filter='{ "operator": "eq", "field": "ASSET_TYPE_ID" }' />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 text-left">
                            <div class="form-group" style="margin-top:10px;">
                                <text>
                                    @if (QCard.ManagementSystem.Service.Modules.Core.Service.FunctionService.HasPermission("ModelMaintenance", Feature.SEARCH_FEATURE))
                                    {
                                        <a class="btn blue trigger" id="btnSearch">
                                            <i class="fa fa-search"></i> <span class="hidden-xs">Search</span>
                                        </a>
                                    }
                                    <a class="btn btn-reset" id="btnClear">
                                        <i class="fa fa-refresh"></i> <span class="hidden-xs">Reset</span>
                                    </a>
                                </text>
                            </div>
                        </div>
                        <div class="col-md-6 text-right">
                            <div class="form-group" style="margin-top:10px;">
                                @if (QCard.ManagementSystem.Service.Modules.Core.Service.FunctionService.HasPermission("ModelMaintenance", Feature.CREATE_FEATURE))
                                {
                                    <a href="#" class="btn btn-success" id="btnAddModel">
                                        <i class="fa fa-plus"></i>Add Product Model
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
           </form>
        </div>
        @await Html.PartialAsync("~/Areas/Core/Views/Model/Grid/_ModelGrid.cshtml")
    </div>

</div>
<style>
    .no-space {
        margin: 0px !important;
        padding: 10px !important;
    }
</style>
<script>
    $(document).ready(function () {
        App.ModelManagement = new ModelManagement();
        App.ModelManagement.InitManagement();
    });
</script>