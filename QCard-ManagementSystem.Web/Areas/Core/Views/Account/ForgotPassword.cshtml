@model object
@{
	Layout = "_LoginLayout";
}
@section scripts {
	@Html.Partial("~/Areas/Core/Views/Account/Script/_ForgotPassword.cshtml")
}
<div class="container">
	<div class="form-box">
		<div class="logo">
			<img src="~/img/liugong.png" alt="logo" alt="logo" class="logo-default">
		</div>
		@* <div class="header-text1">
			Q-Mys
		</div> *@
		<div class="header-text2">
			Forgot Password
		</div>

		<div class="kt-login__signin">
			<form id="forgotPasswordform">
				<div class="form-group">
					<div class="input-container">
						<i class="fa fa-envelope icon" aria-hidden="true"></i>
						<input id="Email" name="Email" class="form-control form-control-solid placeholder-no-fix" style="margin:0px;" autocomplete="off" placeholder="Email"/>
						<span class="text-danger"></span>
					</div>
				</div>
				<div class="kt-login__actions">
					<button type="button" id="btnForgotPassword" class="btn btn-primary">Send Reset Password Link</button>
				</div>
				<div class="text" style="text-align:center; margin-top:10px;">
					Already have an account? Sign in
					<a href="/Core/Account/Login">here.</a>
				</div>
			</form>
		</div>

	</div>
</div>