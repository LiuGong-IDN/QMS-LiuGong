<script type="text/javascript">
    function ResetPasswordManagement() {
        return {
            // state
            token: null,
            minPasswordLength: 8,

            InitManagement: function () {
                this.InitControls();
                this.InitValidation();
                this.InitHandlers();
            },

            InitControls: function () {
                // Ambil token dari query string ?token=...
                const params = new URLSearchParams(window.location.search);
                this.token = params.get('token') || '';

                // Hapus token dari address bar segera untuk mengurangi referer leak
                if (this.token) {
                    try {
                        const newUrl = window.location.origin + window.location.pathname;
                        history.replaceState({}, document.title, newUrl);
                    } catch (err) {
                        console.warn('Tidak dapat menghapus token dari URL', err);
                    }
                }

                // Jika token tidak ada, disable submit dan tampilkan pesan
                if (!this.token) {
                    $('#submitBtn').prop('disabled', true);
                    this.ShowError('Token tidak ditemukan. Pastikan Anda membuka link reset dari email yang dikirim.');
                } else {
                    this.HideMessages();
                }
            },

            InitValidation: function () {
                // Placeholder — jika pakai plugin validation, inisialisasi di sini.
            },

            InitHandlers: function () {
                const self = this;

                // Tombol submit
                $('#submitBtn').on('click', function (e) {
                    e.preventDefault();
                    self.ClearMessages();
                    var message = "";
                    var $el = $(this);
                    $el.prop("disabled", true);

                    var form = $("#ResetPasswordform");
                    var formData = {};
                    form.serializeArray().forEach(function (item) {
                        formData[item.name] = item.value;
                    });

                    const pw = formData.password;
                    const confirm = formData.confirm;

                    if (pw !== confirm) {
                        message = "The password and confirmation password do not match.";
                        Swal.fire({
                            icon: "error",
                            title: "Error",
                            text: message
                        });
                        $el.prop("disabled", false);
                        return;
                    }

                    if (!self.token) {
                        message = "The verification token could not be found. Please reopen the link sent to your email.";
                        Swal.fire({
                            icon: "error",
                            title: "Error",
                            text: message
                        });
                        $el.prop("disabled", false);
                        return;
                    }

                    var request = {
                        Token: self.token,
                        NewPassword: formData.password
                    };
                    console.log(request)

                    $.ajax({
                        url: "@Url.Content("~/Core/Account/ResetPassword")",
                        type: "POST",
                        data: { request: request },
                        success: function (res) {
                            if (res.Success == false || res.Success == "false") {
                                if (!res.Validate) {
                                    ShowErrorMessage(form, JSON.parse(res.Message));
                                } else {
                                    Swal.fire({
                                        icon: "error",
                                        title: "Error",
                                        text: res.Message
                                    });
                                }
                            } else {
                                Swal.fire({
                                    title: "Success",
                                    icon: "success",
                                    text: "Opening login page in 2 seconds.",
                                    timer: 2000
                                }).then(function () {
                                    window.location.replace(loginUrl);
                                });
                            }
                        }
                    })
                    .fail(function (xhr, status, err) {
                        Swal.fire({
                            icon: "error",
                            title: "Error",
                            text: `${status}: ${xhr.responseText || err}`
                        });
                    })
                    .always(function () {
                        $el.prop("disabled", false);
                    });
                });

                // Tekan Enter -> trigger submit
                $('#password, #confirm').on('keyup', function (e) {
                    if (e.key === 'Enter') {
                        $('#submitBtn').trigger('click');
                    }
                });
            },

            // UI helpers
           

            ShowSuccess: function (message) {
                $('#msgSuccess').text(message).show();
                $('#msgError').hide();
            },

            ShowError: function (message) {
                $('#msgError').text(message).show();
                $('#msgSuccess').hide();
            },

            ClearMessages: function () {
                $('#msgSuccess').hide().text('');
                $('#msgError').hide().text('');
            },

            HideMessages: function () {
                $('#msgSuccess').hide();
                $('#msgError').hide();
            }
        };
    }

    $(document).ready(function () {
        ResetPasswordManagement = new ResetPasswordManagement();
        ResetPasswordManagement.InitManagement();
    });
</script>
