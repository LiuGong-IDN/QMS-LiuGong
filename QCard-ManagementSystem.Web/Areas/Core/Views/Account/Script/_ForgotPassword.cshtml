<script type="text/javascript">
    function ForgotPasswordManagement() {
        return {
            // state
            token: null,
            minPasswordLength: 8,

            InitManagement: function () {
                this.InitControls();
                this.InitValidation();
                this.InitHandlers();
            },

            InitControls: function () {
            },

            InitValidation: function () {
            },

            InitHandlers: function () {
                $("#btnForgotPassword").on('click', function (event) {
                    event.preventDefault();
                    var $el = $(this);
                    $el.prop("disabled", true);

                    var form = $("#forgotPasswordform");
                    var formData = {};
                    form.serializeArray().forEach(function (item) {
                        formData[item.name] = item.value;
                    });
                    var baseUrl = window.location.origin; // otomatis http/https + host + port
                    var resetPasswordUrl = `${baseUrl}/core/account/ResetPassword`;
                    var loginUrl = `${baseUrl}/core/account/login`;
                    var request = {
                        Email: formData.Email,
                        BaseUrl: resetPasswordUrl
                    }
                    $.ajax({
                        url: "@Url.Content("~/Core/Account/ForgotPassword")",
                        type: "POST",
                        data: { request: request },
                        success: function (res) {
                            if (res.Success == false || res.Success == "false") {
                                if(!res.Validate){
                                    ShowErrorMessage($form, JSON.parse(res.Message));
                                }
                                else{
                                    Swal.fire({
                                        icon: "error",
                                        title: "Error",
                                        text: res.Message || "Invalid validation message format."
                                    });
                                }
                            }
                            else {
                                Swal.fire({
                                    title: "Success",
                                    icon: "success",
                                    text: "Opening login page in 2 seconds.",
                                    timer: 2000
                                }).then(function () {
                                    window.location.replace(loginUrl);
                                });
                            }
                        }
                    })
                    .fail(function (xhr, status, err) {
                        Swal.fire({
                            icon: "error",
                            title: "Error",
                            text: `${status}: ${xhr.responseText || err}`
                        });
                    });
                    $el.prop("disabled", false);
                });
            },
        };
    }

    $(document).ready(function () {
        ForgotPasswordManagement = new ForgotPasswordManagement();
        ForgotPasswordManagement.InitManagement();
    });
</script>
