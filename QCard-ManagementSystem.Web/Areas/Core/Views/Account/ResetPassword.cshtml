@model object
@{
	Layout = "_LoginLayout";
}

@section scripts {
	@Html.Partial("~/Areas/Core/Views/Account/Script/_ResetPassword.cshtml")
}
<div class="container" id="ResetPasswordView">
	<div class="form-box">
		<div class="logo">
			<img src="~/img/liugong.png" alt="logo" alt="logo" class="logo-default">
		</div>
		@* <div class="header-text1">
			Q-Mys
		</div> *@
		<div class="header-text2">
			Reset Password
		</div>

		<div class="kt-ResetPassword__signin">
			<p class="hint">Enter a new password for your account. The reset link is only valid for a short time.</p>
			<form id="ResetPasswordform">
				<div class="form-group">
					<label for="password">New Password</label>
					<div class="input-container">
						<i class="fa fa-user icon" aria-hidden="true"></i>
						<input id="password" name="password" class="form-control form-control-solid placeholder-no-fix" style="margin:0px;" type="password" autocomplete="off" />
						<span class="text-danger"></span>
					</div>
				</div>

				<div class="form-group">
					<label for="confirm">Confirm Password</label>
					<div class="input-container">
						<i class="fa fa-user icon" aria-hidden="true"></i>
						<input id="confirm" name="confirm" class="form-control form-control-solid placeholder-no-fix" style="margin:0px;" type="password" autocomplete="off" />
						<span class="text-danger"></span>
					</div>
				</div>

				<div class="kt-login__actions">
					<button id="submitBtn" type="submit" class="btn btn-brand btn-elevate btn-primary">Change Password</button>
				</div>

				<div id="msgSuccess" class="msg success"></div>
				<div id="msgError" class="msg error"></div>

				<div class="text" style="text-align:center; margin-top:10px;">
					Cancel password reset? Go back to sign in
					<a href="/Core/Account/Login">here.</a>
				</div>
			</form>
		</div>

	</div>
</div>