@using QCard.ManagementSystem.Domain.Modules.Core.ViewModel;

@(Html.Kendo().Grid<QCard.ManagementSystem.Domain.Modules.Core.Model.CustomerMaintenance>()
    .Name("CustomerGrid")
    .Columns(columns =>
    {
        columns.Bound(o => o.ID).Title("Action").Sortable(false).Width(70).HtmlAttributes(new { @class = "text-center", style = "overflow: visible;" }).Filterable(false).ClientTemplate(
        @"<div class=""btn-group action-btn-group"">" +
            "#if (" + @QCard.ManagementSystem.Service.Modules.Core.Service.FunctionService.HasPermission("CustomerMaintenance", Feature.UPDATE_FEATURE).ToString().ToLower() + ")" +
            "{#" +
                @"<a class=""k-grid-edit cursor-pointer action-btn"" data-modal='CustomerModal' data-ID='#: ID#' title=""Edit""><i class=""fa fa-edit fa-lg""></i></a>&nbsp;" +
            "#}#" +
            "#if (" + @QCard.ManagementSystem.Service.Modules.Core.Service.FunctionService.HasPermission("CustomerMaintenance", Feature.DELETE_FEATURE).ToString().ToLower() + ")" +
            "{#" +
                @"<a class=""k-grid-delete cursor-pointer action-btn"" data-ID='#: ID#' title=""Delete""><i class=""fas fa-trash-alt fa-lg""></i></a>&nbsp;" +
            "#}#" +
        @"</div>");
        columns.Bound(o => o.COMPANY_CODE).Title("Company Code").Width(200);
        columns.Bound(o => o.COMPANY_NAME).Title("Company Name").Width(200);
        columns.Bound(o => o.ADDRESS).Title("Address").Width(200);
        columns.Bound(o => o.CREATED_BY).Title("Created By").Width(200);
        columns.Bound(o => o.CREATED_DATE).Title("Created Date").Width(200).ClientTemplate("#= kendo.toString(CREATED_DATE, 'dd-MMM-yyyy hh:mm:ss') #");
    })
    .Reorderable(reorderable => reorderable.Columns(true))
    .Resizable(resizable => resizable.Columns(true))
    .NoRecords(conf => conf.Template("No Customer List to display"))
    .Pageable(pageable => pageable.PageSizes(new[] { 5, 10, 20, 100, 200 }).ButtonCount(5))
    .Sortable()
    .Scrollable(s => s.Height("auto"))
    .DataSource(dataSource => dataSource
        .Ajax()
        .Read(read => read.Url(Url.Content("~/core/Customer/Read")).Data("setParameter"))
        .PageSize(10)
        .Sort(sort => sort.Add("CREATED_DATE").Descending())
    )
)
<style>
    .action-btn-group {
        display: flex;
        justify-content: center;
        gap: 4px; /* jarak antar button */
    }

    .action-btn {
        display: inline-flex;
        align-items: center;
    }
</style>