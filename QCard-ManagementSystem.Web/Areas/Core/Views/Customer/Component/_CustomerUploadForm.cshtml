<div id="CustomerUploadModal" class="modal fade bs-modal-lg" abindex="-1" role="dialog" aria-hidden="true" style="display: none;">
    <div class="modal-dialog modal-lg" style="min-width: 50%">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">Upload New Customer</h4>
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true"></button>
            </div>
            <div class="modal-body">
                <form id="UploadCustomerForm">
                    <div class="row form-group">
                        <label class="col-md-12">File<span class="required"> *</span></label>
                        <div class="col-md-12">
                            <div id="uploadDiv">
                                <input type="file" id="fileUploadCustomer" name="fileUploadCustomer" accept=".xlsx" multiple>
                            </div>
                        </div>
                    </div>
                    <input type="hidden" id="TempCode" />
                </form>
                @await Html.PartialAsync("~/Areas/Core/Views/Customer/Grid/_CustomerUploadGrid.cshtml")
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-outline-brand btn-square" data-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
</div>

<script type="text/x-kendo-template" id="CustomerUploadButtons">
    <div class="row">
        <div class="col-md-12">
            <div class="form-group">
                <br />
                <button type="button" class="btn btn-success btn-sm" id="btnSubmitUpload" title="Create" style="width:50px; display: none;">Submit</button>
                <button type="button" class="btn btn-danger btn-sm" id="btnDownloadErrorUpload" title="Download" style="width:70px; display: none;">Download</button>
            </div>
        </div>
    </div>
</script>

<script>
    $(document).ready(function () {
        var templateHtml = $("#CustomerUploadButtons").html();
        $("#CustomerUploadGrid .k-grid-toolbar").html(templateHtml);
    });
</script>
