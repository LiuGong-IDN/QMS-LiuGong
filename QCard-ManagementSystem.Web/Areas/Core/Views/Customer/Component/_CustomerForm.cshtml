@model QCard.ManagementSystem.Domain.Modules.Core.Model.CustomerMaintenance
<div id="CustomerModal" class="modal fade bs-modal-lg" abindex="-1" role="dialog" aria-hidden="true" style="display: none;">
    <div class="modal-dialog" style="min-width: 50%">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title"><label id="modalTitle">Customer</label></h4>
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true"></button>
            </div>
            <div class="modal-body">
                <form id="CustomerForm">
                    <input type="hidden" name="ID" id="ID" data-bind="value: ID" /> @*untuk update mengambil id dari grid*@
                    <div class="form-group">
                        <label>Company Code</label>
                        @Html.TextBoxFor(x => x.COMPANY_CODE, new { @class = "form-control", id = "COMPANY_CODE" })
                        <span class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label>Company Name</label>
                        @Html.TextBoxFor(x => x.COMPANY_NAME, new { @class = "form-control", id = "COMPANY_NAME" })
                        <span class="text-danger id"></span>
                    </div>
                    <div class="form-group">
                        <label>Address</label>
                        @Html.TextAreaFor(x => x.ADDRESS, new { @class = "form-control", id = "ADDRESS" })
                        <span class="text-danger"></span>
                    </div>
                </form>
                <div class="modal-footer">
                    <button type="button" class="btn btn-reset btn-sm" data-dismiss="modal"><i class="fa fa-times mr-1"></i> Close</button>
                    <button type="button" class="btn btn-default blue btn-sm" id="btnSaveCustomer" style="background-color:#002F75; border-color:#002F75;color:white;"><i class="fa fa-save"></i>&nbsp;Save</button>
                    <button type="button" class="btn btn-default blue btn-sm" id="btnUpdateCustomer" style="background-color:#002F75; border-color:#002F75;color:white;"><i class="fa fa-save"></i>Update</button>
                </div>
            </div>
        </div>
    </div>
</div>

