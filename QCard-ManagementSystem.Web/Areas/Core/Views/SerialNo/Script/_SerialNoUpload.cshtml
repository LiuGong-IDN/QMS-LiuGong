<script>
    function SerialNoUploadManager(){
        return{
            InitManagement: function () {
                this.InitControl();
                this.InitHandlers();
                this.InitValidation();
            },
            InitControl: function () {
            },
            InitValidation: function () {
            },
            InitHandlers: function () {
                $("#fileUploadUser").kendoUpload({
                    async: {
                        saveUrl: "@Url.Content("~/Core/DataSource/UploadExcel")",
                        autoUpload: true
                    },
                    validation: {
                        allowedExtensions: [".xlsx"]
                    },
                    select: function (e) {
                        if (e.files.length == 0) {
                            Swal.fire({
                              icon: "error",
                              title: "Error",
                              text: "No file has been uploaded"
                            });
                            return;
                        }
                        var data = new FormData();
                        for (var i = 0; i < e.files.length; i++) {
                            data.append("Upload", e.files[i].rawFile);
                        }

                        $.ajax({
                            url: "@Url.Content("~/Core/User/UploadProcess")",
                            type: 'POST',
                            contentType: false,
                            processData: false,
                            data: data,
                            success: function (res) {
                                if (res.isSaved == true) {
                                    $("#TempCode").val(res.tempCode);
                                    $('#UserUploadGrid').data("kendoGrid").dataSource.read();

                                    if (res.canSubmit == false && res.message != null && res.message.trim() !== '') {
                                        Swal.fire({
                                          icon: "error",
                                          title: "Error",
                                          text: res.message || "An error occurred while uploading"
                                        });
                                        $("#btnDownloadErrorUpload").hide();
                                        $("#btnSubmitUpload").hide();
                                    }
                                    if (res.canSubmit == true) {
                                        $("#btnSubmitUpload").show();
                                        $("#btnDownloadErrorUpload").hide();
                                    }
                                    else {
                                        $("#btnDownloadErrorUpload").show();
                                        $("#btnSubmitUpload").hide();
                                    }
                                } else {
                                    $("#btnSubmitUpload").hide();
                                    $("#btnDownloadErrorUpload").hide();
                                    Swal.fire({
                                        icon: "error",
                                        title: "Error",
                                        text: res.message || "An error occurred while uploading"
                                    });
                                }
                            }
                        })
                        .fail(function (xhr, status, err) {
                            Swal.fire({
                                icon: "error",
                                title: "Error",
                                text: `${status}: ${xhr.responseText || err}`
                            });
                        });
                    },
                    success: function (e) {
                        console.log(e);
                    },
                    multiple: false,
                });

                $("#btnSubmitUpload").on('click', function (event) {
                    var $el = $(this),
                        $modal = $(this).closest(".modal");

                    var tempCode = $("#TempCode").val();
                    $.post("@Url.Content("~/Core/User/SubmitExcelUpload")", { tempCode: tempCode }, function (d) {
                        if (d.status === "Success") {
                            $modal.modal("hide");
                            Swal.fire("Saved!", "", "success");
                            $.helper.grid.refresh("UserGrid");
                        } else {
                            Swal.fire({
                              icon: "error",
                              title: "Error",
                              text: d.message || "Upload failed. Please check your data."
                            });
                        }
                    })
                    .fail(function (xhr, status, err) {
                        Swal.fire({
                            icon: "error",
                            title: "Error",
                            text: `${status}: ${xhr.responseText || err}`
                        });
                    })
                    .always(function () {
                        $el.prop("disabled", false);
                    });
                });

                $("#btnDownloadErrorUpload").on('click', function (event) {
                    window.location.href = "@Url.Content("~/Core/User/DownloadExcelError?tempCode=")" + $("#TempCode").val();
                });
            },
        };
    }

    function sendTempCode() {
        return {
            tempCode: $("#TempCode").val()
        };
    }

    $(document).ready(function () {
        UserUploadManager = new UserUploadManager();
        UserUploadManager.InitManagement();
    });
</script>