<script type="text/javascript">
    var SourceDataLocCodes = [];
    var tempUL = "";
    var Id = "";
    var uploadedEvidenceFileName = null;

    function SerialNoAddManagement() {
        return {
            InitManagement: function () {
                this.InitControls();
                this.InitValidation();
                this.InitHandlers();
            },
            InitControls: function () {
                $("input.text-uppercase").on("input", function () {
                    this.value = this.value.toUpperCase().replace(/\s+/g, "");
                });
                $("input.no-space-input").on("input", function () {
                    this.value = this.value.replace(/\s+/g, "");
                });

                toggleSections();

                $("input[name='PROGRAM_CATEGORY']").change(function () {
                    toggleSections();
                });

                formatRupiahInputWithPrefix("VOUCHER_AMOUNT");

                $("#PURCHASE_DATE").kendoDatePicker({
                    format: "yyyy-MM-dd",
                    parseFormats: ["yyyy-MM-dd", "MM/dd/yyyy"],
                });
                $("#CUSTOMER_ID").kendoDropDownList({
                    dataTextField: "Text",
                    dataValueField: "Value",
                    dataSource: {
                        transport: {
                            read: {
                                url: "@Url.Content("~/Core/DataSource/GetCustomerList")",
                                dataType: "json"
                            }
                        }
                    },
                    index: 0,
                    filter: "contains",
                    suggest: true,
                    optionLabel: "Select customer..."
                });
                $("#ASSET_TYPE_ID").kendoDropDownList({
                    dataTextField: "Text",
                    dataValueField: "Value",
                    dataSource: {
                        transport: {
                            read: {
                                cache: false,
                                url: "@Url.Content("~/Core/DataSource/GetAssetType")",
                                dataType: "json"
                            }
                        }
                    },
                    index: 0,
                    filter: "contains",
                    suggest: true,
                    optionLabel: "Select product group...",
                    change: function () {
                        var assetTypeId = this.value();
                        var modelDropdown = $("#MODEL_ID").data("kendoDropDownList");

                        // refresh data model sesuai asset type
                        modelDropdown.dataSource.transport.options.read.url =
                            "@Url.Content("~/Core/DataSource/GetModelByAssetTypeList")?assetTypeId=" + assetTypeId;
                        modelDropdown.dataSource.read();
                        modelDropdown.value(""); // reset pilihan model

                        // --- Tambahkan logika ini ---
                        // Jika option label dipilih (value kosong), disable tombol Add Program
                        if (!assetTypeId) {
                            $("#btnAddProgramDetail").prop("disabled", true);
                            removeAllRow();
                        } else {
                            $("#btnAddProgramDetail").prop("disabled", true); // tetap disable karena model belum dipilih
                            removeAllRow();
                        }

                        // Panggil ajax image preview
                        $.ajax({
                            url: "@Url.Content("~/Core/DataSource/GetFileImage")",
                            type: "GET",
                            data: {
                                fileCategory: 'ASSET_TYPE',
                                fileCategoryId: assetTypeId
                            },
                            success: function (res) {
                                if (res && res.imageUrl) {
                                    $("#MachineImagePreview").attr("src", res.imageUrl);
                                } else {
                                    $("#MachineImagePreview").attr("src", "/img/liugongQCard.png");
                                }
                            },
                            error: function () {
                                $("#MachineImagePreview").attr("src", "/img/liugongQCard.png");
                            }
                        });
                    }
                });

                $("#MODEL_ID").kendoDropDownList({
                    dataTextField: "Text",
                    dataValueField: "Value",
                    dataSource: {
                        transport: {
                            read: {
                                url: "@Url.Content("~/Core/DataSource/GetModelByAssetTypeList")",
                                dataType: "json"
                            }
                        }
                    },
                    index: 0,
                    filter: "contains",
                    suggest: true,
                    optionLabel: "Select product model...",
                    change: function (e) {
                        var selectedValue = this.value();
                        removeAllRow();
                        // Jika model dipilih, enable tombol Add Program
                        if (!selectedValue) {
                            $("#btnAddProgramDetail").prop("disabled", true);
                        } else {
                            $("#btnAddProgramDetail").prop("disabled", false);
                        }
                    }
                });

                $("#btnAddProgramDetail").prop("disabled", true);
                $("#SERVICE_PARTY_ID").kendoDropDownList({
                    dataTextField: "Text",
                    dataValueField: "Value",
                    dataSource: {
                        transport: {
                            read: {
                                url: "@Url.Content("~/Core/DataSource/GetServicePartyList")",
                                dataType: "json"
                            }
                        }
                    },
                    index: 0,
                    filter: "contains",
                    suggest: true,
                    optionLabel: "Select service party..."
                });
                
            },
            InitValidation: function () {
                document.getElementById("SERIAL_NO").addEventListener("input", function () {
                    // Hapus karakter selain huruf dan angka
                    this.value = this.value.replace(/[^A-Za-z0-9]/g, '');

                    // Batasi maksimal 16 karakter
                    if (this.value.length > 32) {
                        this.value = this.value.slice(0, 32);
                    }
                });
            },
            InitHandlers: function () {
                var selectedPrograms = [];
                var previousProgram = null;
                // Add Program Detail
                $("#btnAddProgramDetail").on("click", function (e) {
                    e.preventDefault();

                    var modelIdDdl = $("#MODEL_ID").data("kendoDropDownList");
                    var programDataSource = new kendo.data.DataSource({
                        transport: {
                            read: {
                                url: "@Url.Content("~/Core/DataSource/GetProgramListByModelId")",
                                dataType: "json",
                                data: function () {
                                    return {
                                        modelId: modelIdDdl ? modelIdDdl.value() : null
                                    };
                                }
                            }
                        }
                    });
                    var newRow = `
                        <tr>
                            <td class="text-center align-middle">
                                <a class="btnRemoveRow" title="Delete">
                                    <i class="fas fa-trash-alt fa-lg"></i>
                                </a>
                            </td>
                            <td>
                                <input name="PROGRAM_CODE[]" class="form-control programCodeDropdown" />
                                <input type="hidden" name="PROGRAM_ID[]" />
                            </td>
                            <td>
                                <input type="text" name="PROGRAM_NAME[]" class="form-control programNameField" readonly />
                            </td>
                            <td>
                                <input type="number" name="PACKAGE_QTY[]" class="form-control" style="text-align: right;" />
                                <span class="text-danger d-block field-validation-error" data-field="PACKAGE_QTY"></span>
                            </td>
                            <td>
                                <input type="text" name="PRIORITY[]" class="form-control priorityField" readonly/>
                            </td>
                        </tr>
                    `;

                    $("#ProgramTable tbody").append(newRow);

                    // --- Apply Kendo DropDownList ---
                    var $programCodeDropdown = $("#ProgramTable tbody tr:last .programCodeDropdown").kendoDropDownList({
                        dataTextField: "Text",
                        dataValueField: "Value",
                        dataSource: programDataSource,
                        filter: "contains",
                        optionLabel: "Select Program Code...",
                        focus: function () {
                            previousProgram = this.value();
                        },
                        change: function (e) {
                            var dataItem = this.dataItem(this.selectedIndex);
                            var $row = $(this.element).closest("tr");
                            var $programNameField = $row.find(".programNameField");
                            var $priorityField = $row.find(".priorityField");
                            var $programIdField = $row.find("input[name='PROGRAM_ID[]']");
                            var currentValue = this.value();

                            // hapus program lama dari array
                            selectedPrograms = selectedPrograms.filter(function (val) {
                                return val !== previousProgram;
                            });

                            // cek duplikat
                            var duplicateFound = false;
                            $(".programCodeDropdown").each(function () {
                                var ddl = $(this).data("kendoDropDownList");
                                if (ddl && ddl !== $programCodeDropdown && ddl.value() === currentValue) {
                                    duplicateFound = true;
                                    return false; // stop loop
                                }
                            });

                            if (duplicateFound) {
                                Swal.fire({
                                    icon: "error",
                                    title: "Error",
                                    text: "This Program Category has already been selected. Please choose a different one."
                                });

                                this.value("");
                                $programNameField.val("");
                                $priorityField.val("");
                                $programIdField.val("");
                            } else {
                                if (dataItem && dataItem.Value) {
                                    selectedPrograms.push(dataItem.Value);
                                    $programNameField.val(dataItem.Name || "");
                                    $priorityField.val(dataItem.Description || "");
                                    $programIdField.val(dataItem.Value);
                                } else {
                                    $programNameField.val("");
                                    $priorityField.val("");
                                    $programIdField.val("");
                                }
                            }

                            previousProgram = null;
                        }
                    }).data("kendoDropDownList");
                });
                $("#EVIDENCE_PJB").kendoUpload({
                    async: {
                        saveUrl: "/Core/DataSource/UploadEvidence",
                        autoUpload: true,
                        saveField: "EvidenceFile"
                    },
                    validation: {
                        allowedExtensions: [".jpg", ".jpeg", ".png", ".pdf"],
                        maxFileSize: 20971520
                    },
                    multiple: false,
                    showFileList: true,
                    localization: {
                        select: "Select File...",
                        dropFilesHere: "Drop file here to upload"
                    },
                    success: function (e) {
                        if (e.response && e.response.fileName) {
                            uploadedEvidenceFileName = e.response.fileName;
                        } else if (e.files && e.files.length > 0) {
                            uploadedEvidenceFileName = e.files[0].name;
                        }

                        // Swal.fire({
                        //     icon: "success",
                        //     title: "Success",
                        //     // text: "Your evidence file has been uploaded successfully."
                        // });
                    },
                    error: function (e) {
                        console.error("Upload failed:", e);
                        Swal.fire({
                            icon: "error",
                            title: "Error",
                            text: "Please check your file and try again"
                        });
                        uploadedEvidenceFileName = null;
                    }
                });
                // remove row
                $(document).on("click", ".btnRemoveRow", function () {
                    var $row = $(this).closest("tr");
                    var ddl = $row.find(".programCodeDropdown").data("kendoDropDownList");
                    var value = ddl ? ddl.value() : null;

                    if (value) {
                        selectedPrograms = selectedPrograms.filter(function (val) {
                            return val !== value;
                        });
                    }

                    $row.remove();
                });

                $("#btnReset").on("click", function () {
                    location.reload();
                });

                // SAVE Machine
                $("#btnSaveSerialNo").on('click', function (event) {
                    event.preventDefault();

                    var $el = $(this);
                    $el.prop("disabled", true);

                    var $form = $("#MachineForm");
                    var formData = $.helper.form.serializeObject($form);
                    var evidenceFileToSend = uploadedEvidenceFileName || null;

                    // Ambil data dari tabel ProgramTable
                    var programDetails = [];
                    $("#ProgramTable tbody tr").each(function () {
                        var $row = $(this);

                        var programId = $row.find("input[name='PROGRAM_ID[]']").val();
                        var packageQty = parseInt($row.find("input[name='PACKAGE_QTY[]']").val()) || 0;
                        var claimQty = parseInt($row.find("input[name='CLAIM_QTY[]']").val()) || 0;

                        var currentPackageQty = packageQty - claimQty;
                        if (currentPackageQty < 0) currentPackageQty = 0;

                        if (programId) {
                            programDetails.push({
                                PROGRAM_ID: programId,
                                PACKAGE_QTY: packageQty,
                                CLAIM_QTY: claimQty,
                                CURRENT_PACKAGE_QTY: currentPackageQty
                            });
                        }
                    });

                    var isProgram = document.getElementById("IS_PROGRAM").checked;
                    var isVoucher = document.getElementById("IS_VOUCHER").checked;
                    let voucherValue = getNumericValue("VOUCHER_AMOUNT");

                    // Jika dua-duanya dicentang tetapi dua-duanya kosong
                    if (isProgram && isVoucher) {
                        if (programDetails.length === 0 && (!voucherValue || voucherValue <= 0)) {
                            Swal.fire({
                                icon: "error",
                                title: "Error",
                                text: "Program details and Voucher Amount cannot be empty when both options are selected."
                            });
                            $el.prop("disabled", false);
                            return;
                        }
                    }

                    // Jika PROGRAM dicentang tetapi tidak ada detail program
                    if (isProgram && programDetails.length === 0) {
                        Swal.fire({
                            icon: "error",
                            title: "Error",
                            text: "Please add at least one program before saving."
                        });
                        $el.prop("disabled", false);
                        return;
                    }

                    // Jika VOUCHER dicentang tetapi voucher amount tidak diisi / 0
                    if (isVoucher && (!voucherValue || voucherValue <= 0)) {
                        Swal.fire({
                            icon: "error",
                            title: "Error",
                            text: "Please enter a valid voucher amount."
                        });
                        $el.prop("disabled", false);
                        return;
                    }
                    if (!evidenceFileToSend) {
                        Swal.fire({
                            icon: "error",
                            title: "Error",
                            text: "Please upload evidence file before saving."
                        });
                        $el.prop("disabled", false);
                        return;
                    }
                    var dataToSave = {
                        ID: formData.ID || 0,
                        CUSTOMER_ID: formData.CUSTOMER_ID,
                        SERIAL_NO: formData.SERIAL_NO,
                        ASSET_TYPE_ID: formData.ASSET_TYPE_ID,
                        PJB_NO: formData.PJB_NO,
                        EVIDENCE_PJB: evidenceFileToSend,
                        MODEL_ID: formData.MODEL_ID,
                        PURCHASE_DATE: formData.PURCHASE_DATE,
                        SERVICE_PARTY_ID: formData.SERVICE_PARTY_ID,
                        BRANCH: $("#BRANCH").val(),
                        IS_PROGRAM: isProgram,
                        IS_VOUCHER: isVoucher,
                        VOUCHER_AMOUNT: voucherValue,
                        DETAILS: programDetails
                    };

                    $.ajax({
                        url: "@Url.Content("~/Core/SerialNo/Save")",
                        type: "POST",
                        data: { machine : dataToSave },
                        success: function (res) {
                            if (res.Success == false || res.Success == "false") {
                                if (!res.Validate) {
                                    ShowErrorMessage($form, JSON.parse(res.Message));
                                    ShowCheckboxGroupError($form, JSON.parse(res.Message), "PROGRAM_CATEGORY", "#ProgramCategoryError");
                                    ShowSerialNoGridErrorMessage($form, JSON.parse(res.Message));
                                } else {
                                    Swal.fire({
                                      icon: "error",
                                      title: "Error",
                                      text: res.Message
                                    });
                                }
                            } else {
                                Swal.fire({
                                    icon: "success",
                                    title: "Success"
                                }).then((result) => {
                                    if (result.isConfirmed) {
                                        window.location.href = "/Core/SerialNo";
                                    }
                                });
                            }
                        },
                        complete: function () {
                            $el.prop("disabled", false);
                        }
                    })
                    .fail(function (xhr, status, err) {
                        Swal.fire({
                            icon: "error",
                            title: "Error",
                            text: `${status}: ${xhr.responseText || err}`
                        });
                    });
                });
            }
        };
    }

    function removeAllRow() {
        $("#ProgramTable tbody tr").remove();
    }

    $.helper.form.fill = function ($form, dataItem, excludeIds) {
        $form.find(':input').each(function () {
            let id = $(this).attr('id');
            if (excludeIds && excludeIds.includes(id)) {
                return;
            }
            if (id && dataItem[id] !== undefined) {
                $(this).val(dataItem[id]);
            }
        });
    };

    function toggleSections() {
        // Cek checkbox program
        if ($("#IS_PROGRAM").is(":checked")) {
            $("#divProgramDetail").show();
        } else {
            $("#divProgramDetail").hide();
            removeAllRow();
        }

        // Cek checkbox voucher
        if ($("#IS_VOUCHER").is(":checked")) {
            $("#divVoucherDetail").show();
        } else {
            $("#divVoucherDetail").hide();
            $("#VOUCHER_AMOUNT").val("");
        }
    }

    function formatRupiahInputWithPrefix(inputId) {
        const el = document.getElementById(inputId);

        el.addEventListener("input", function (e) {
            let value = e.target.value.replace(/[^0-9]/g, "");

            if (value) {
                e.target.value = "Rp " + new Intl.NumberFormat("id-ID").format(value);
            } else {
                e.target.value = "";
            }
        });
    }

    function getNumericValue(inputId) {
        const el = document.getElementById(inputId);
        return el.value.replace(/[^0-9]/g, "");
    }

</script>
