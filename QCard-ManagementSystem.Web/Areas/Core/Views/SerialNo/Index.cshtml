@using QCard.ManagementSystem.Domain.Modules.Core.ViewModel

@section scripts {
    @Html.Partial("~/Areas/Core/Views/SerialNo/Script/_SerialNo.cshtml")
}

<div class="portlet light margin-bottom-0">
    <div class="row">
        <div class="col-xs-6">
            <div class="page-head">
                <div class="page-title">
                    <h1>
                        <span>Serial No. List</span>
                    </h1>
                </div>
            </div>
        </div>
    </div>
    <br />

    <div class="portlet light bordered">
        <div class="portlet-body">
            <form data-grid="SerialNoGrid" data-filter="true" data-logical-operator="and" method="post">
                @Html.AntiForgeryToken()
                <div class="inputs inputs-full-width">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="serialNoFilter"><b>Serial No.</b></label>
                                <input id="serialNoFilter" maxlength="32" type="text" class="form-control text-uppercase no-space-input" data-filter='{ "operator": "contains", "field": "SERIAL_NO" }' />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="ASSET_TYPE-FILTER"><b>Product Group</b></label>
                                <input id="ASSET_TYPE-FILTER" name="ASSET_TYPE_ID" class="form-control" data-filter='{ "operator": "eq", "field": "ASSET_TYPE_ID" }' />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 text-left">
                            <div class="form-group" style="margin-top:10px;">
                                <text>
                                    @if (QCard.ManagementSystem.Service.Modules.Core.Service.FunctionService.HasPermission("SerialNoMaintenance", Feature.SEARCH_FEATURE))
                                    {
                                        <a class="btn blue trigger" id="btnSearch">
                                            <i class="fa fa-search"></i> <span class="hidden-xs">Search</span>
                                        </a>
                                    }
                                    <a class="btn btn-reset" id="btnClear">
                                        <i class="fa fa-refresh"></i> <span class="hidden-xs">Reset</span>
                                    </a>
                                    
                                </text>
                            </div>
                        </div>
                        <div class="col-md-6 text-right">
                            <div class="form-group" style="margin-top:10px;">
                                @if (QCard.ManagementSystem.Service.Modules.Core.Service.FunctionService.HasPermission("SerialNoMaintenance", Feature.CREATE_FEATURE))
                                {
                                    <a href="#" class="btn btn-success" id="btnAddSerialNo">
                                        <i class="fa fa-plus"></i>Add Serial No.
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
        @await Html.PartialAsync("~/Areas/Core/Views/SerialNo/Grid/_SerialNoGrid.cshtml")
    </div>

</div>
<style>
</style>
<script>
    $(document).ready(function () {
        App.SerialNoManagement = new SerialNoManagement();
        App.SerialNoManagement.InitManagement();
    });
</script>