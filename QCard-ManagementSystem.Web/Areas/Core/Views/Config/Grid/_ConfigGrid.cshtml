@using QCard.ManagementSystem.Domain.Modules.Core.ViewModel;

@(Html.Kendo().Grid<QCard.ManagementSystem.Domain.Modules.Core.Model.Config>()
    .Name("ConfigGrid")
    .Columns(columns =>
    {
        columns.Bound(o => o.SYSTEM_TYPE).Title("Action").Sortable(false).Width(70).HtmlAttributes(new { @class = "text-center", style = "overflow: visible;" }).Filterable(false).ClientTemplate(
        @"<div class=""btn-group action-btn-group"">" +
            "#if (" + @QCard.ManagementSystem.Service.Modules.Core.Service.FunctionService.HasPermission("ConfigMaintenance", Feature.UPDATE_FEATURE).ToString().ToLower() + ")" +
            "{#" +
                @"<a class=""k-grid-edit cursor-pointer action-btn"" data-modal='ConfigModal' title=""Edit""><i class=""fa fa-edit fa-lg""></i></a>&nbsp;" +
            "#}#" +

            "#if (" + @QCard.ManagementSystem.Service.Modules.Core.Service.FunctionService.HasPermission("ConfigMaintenance", Feature.DELETE_FEATURE).ToString().ToLower() + ")" +
            "{#" +
                @"<a class=""k-grid-delete cursor-pointer action-btn"" title=""Delete""><i class=""fas fa-trash-alt fa-lg""></i></a>&nbsp;" +
            "#}#" +
        @"</div>");
        columns.Bound(o => o.SYSTEM_TYPE).Title("System Type").Width(300);
        columns.Bound(o => o.SYSTEM_VALUE_TEXT).Title("Value Text").Width(300);
        columns.Bound(o => o.SYSTEM_VALUE_NUM).Title("Value Numeric").Width(300);
    })
    .Reorderable(reorderable => reorderable.Columns(true))
    .Resizable(resizable => resizable.Columns(true))
    .NoRecords(conf => conf.Template("No Config List to display"))
    .Pageable(pageable => pageable.PageSizes(new[] { 5, 10, 20, 100, 200 }).ButtonCount(5))
    .Sortable()
    .Scrollable(s => s.Height("auto"))
    .DataSource(dataSource => dataSource
        .Ajax()
        .Read(read => read.Url(Url.Content("~/core/config/read")))
        .PageSize(10)
        .Sort(sort => sort.Add("CREATED_DT").Descending())
    )
)
<style>
    .action-btn-group {
        display: flex;
        justify-content: center;
        gap: 4px; /* jarak antar button */
    }

    .action-btn {
        display: inline-flex;
        align-items: center;
    }
</style>