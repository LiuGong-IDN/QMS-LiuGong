@using Kendo.Mvc.UI;
@using QCard.ManagementSystem.Domain.Modules.Core.ViewModel;

@(Html.Kendo().Grid<QCard.ManagementSystem.Domain.Modules.Core.Model.UserUpload>()
    .Name("UserUploadGrid")
    .ToolBar(toolbar => { toolbar.Custom().Text(" "); })
    .Columns(columns =>
    {
        columns.Bound(o => o.ACTION).Title("Action").Width(100);
        columns.Bound(o => o.NO).Title("No").Width(110);
        columns.Bound(o => o.FIRST_NAME).Title("First Name").Width(300);
        columns.Bound(o => o.LAST_NAME).Title("Last Name").Width(300);
        columns.Bound(o => o.PHONE_NUMBER).Title("Phone Number").Width(300);
        columns.Bound(o => o.EMAIL).Title("Email").Width(300);
        columns.Bound(o => o.PASSWORD).Title("Password").Width(300);
        columns.Bound(o => o.ROLE_NAME).Title("Role Name").Width(300);
        columns.Bound(o => o.STATUS).Title("Status").Width(120);
        columns.Bound(o => o.MESSAGE).Title("Message").Width(300);
    })
    .Reorderable(reorderable => reorderable.Columns(true))
    .Resizable(resizable => resizable.Columns(true))
    .NoRecords(conf => conf.Template("No Data List to display"))
    .Pageable(pageable => pageable.PageSizes(new[] { 5, 10, 20, 100, 200 }).ButtonCount(5))
    .Sortable()
    .Scrollable(s => s.Height("auto"))
    .DataSource(dataSource => dataSource
        .Ajax()
        .Read(read => read.Url(Url.Content("~/Core/User/ReadUploadedData")).Data("sendTempCode"))
        .PageSize(10)
        .Sort(sort => sort.Add("NO").Ascending())
    )
    .AutoBind(false)
)