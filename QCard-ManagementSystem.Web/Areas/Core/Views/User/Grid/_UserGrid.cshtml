@using QCard.ManagementSystem.Domain.Modules.Core.ViewModel;

@(Html.Kendo().Grid<QCard.ManagementSystem.Domain.Modules.Core.ViewModel.UserView>()
    .Name("UserGrid")
    .Columns(columns =>
    {
        columns.Bound(o => o.ID).Title("Action").Sortable(false).Width(70).HtmlAttributes(new { @class = "text-center", style = "overflow: visible;" }).Filterable(false).ClientTemplate(
        @"<div class=""btn-group action-btn-group"">" +
            "#if (" + @QCard.ManagementSystem.Service.Modules.Core.Service.FunctionService.HasPermission("UserMaintenance", Feature.UPDATE_FEATURE).ToString().ToLower() + ")" +
            "{#" +
                @"<a class=""k-grid-edit cursor-pointer action-btn"" data-modal='UserModal' data-ID='#: ID#' title=""Edit""><i class=""fa fa-edit fa-lg""></i></a>&nbsp;" +
            "#}#" +
            "#if (" + @QCard.ManagementSystem.Service.Modules.Core.Service.FunctionService.HasPermission("UserMaintenance", Feature.DELETE_FEATURE).ToString().ToLower() + ")" +
            "{#" +
                @"<a class=""k-grid-delete cursor-pointer action-btn"" data-ID='#: ID#' title=""Delete""><i class=""fas fa-trash-alt fa-lg""></i></a>&nbsp;" +
            "#}#" +
        @"</div>");
        columns.Bound(o => o.FIRST_NAME).Title("First Name").Width(200);
        columns.Bound(o => o.LAST_NAME).Title("Last Name").Width(200);
        columns.Bound(o => o.PHONE_NUMBER).Title("Phone No.").Width(200);
        columns.Bound(o => o.EMAIL).Title("Email").Width(200);
        columns.Bound(o => o.COMPANY).Title("Company").Width(200);
        columns.Bound(o => o.ROLE_NAME).Title("Role Name").Width(200);
        columns.Bound(o => o.PDC).Title("PDC").Width(300);
    })
    .Reorderable(reorderable => reorderable.Columns(true))
    .Resizable(resizable => resizable.Columns(true))
    .NoRecords(conf => conf.Template("No User List to display"))
    .Pageable(pageable => pageable.PageSizes(new[] { 5, 10, 20, 100, 200 }).ButtonCount(5))
    .Sortable()
    .Scrollable(s => s.Height("auto"))
    .DataSource(dataSource => dataSource
        .Ajax()
        .Read(read => read.Url(Url.Content("~/core/user/read")))
        .PageSize(10)
        .Sort(sort => sort.Add("CREATED_DATE").Descending())
    )
)
<style>
    .action-btn-group {
        display: flex;
        justify-content: center;
        gap: 4px; /* jarak antar button */
    }

    .action-btn {
        display: inline-flex;
        align-items: center;
    }
</style>