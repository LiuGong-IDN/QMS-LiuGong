@using QCard.ManagementSystem.Domain.Modules.Core.ViewModel;

@(Html.Kendo().Grid<QCard.ManagementSystem.Domain.Modules.Core.ViewModel.ProgramView>()
    .Name("ProgramGrid")
    .Columns(columns =>
    {
        columns.Bound(o => o.ID).Title("Action").Sortable(false).Width(100)
        .HtmlAttributes(new { @class = "text-center", style = "overflow: visible;" })
        .Filterable(false)
        .ClientTemplate(
        @"<div class='btn-group action-btn-group'>" +
            "#if (" + @QCard.ManagementSystem.Service.Modules.Core.Service.FunctionService.HasPermission("ProgramMaintenance", Feature.UPDATE_FEATURE).ToString().ToLower() + ") {#" +
                @"<a class='action-btn' href='" + Url.Action("Edit", "Program", new { area = "Core" }) + @"/#: ID#'>
                <i class='fa fa-edit fa-lg'></i>
              </a>" +
            "#}#" +
            "#if (" + @QCard.ManagementSystem.Service.Modules.Core.Service.FunctionService.HasPermission("ProgramMaintenance", Feature.DELETE_FEATURE).ToString().ToLower() + ") {#" +
                @"<a class='k-grid-delete action-btn' data-ID='#: ID #' title='Delete'>
                    <i class='fa fa-trash-alt fa-lg'></i>
                  </a>&nbsp;" +
            "#}#" +
            "#if (" + @QCard.ManagementSystem.Service.Modules.Core.Service.FunctionService.HasPermission("ProgramMaintenance", Feature.VIEW_FEATURE).ToString().ToLower() + ") {#" +
                @"<a class='action-btn' href='" + Url.Action("Details", "Program", new { area = "Core" }) + @"/#: ID#'>
                    <i class='fa fa-file fa-lg'></i>
                  </a>" +
            "#}#" +
        @"</div>");
        columns.Bound(o => o.PROGRAM_NO).Title("Program Category").Width(200);
        columns.Bound(o => o.MACHINE_TYPE).Title("Product Group").Width(200);
        columns.Bound(o => o.MODEL_NAME).Title("Product Model").Width(200);
        columns.Bound(o => o.CREATED_BY).Title("Created By").Width(200);
        columns.Bound(o => o.CREATED_DATE).Title("Created Date").Width(200).ClientTemplate("#= kendo.toString(CREATED_DATE, 'dd-MMM-yyyy HH:mm:ss') #");
    })
    .Reorderable(reorderable => reorderable.Columns(true))
    .Resizable(resizable => resizable.Columns(true))
    .NoRecords(conf => conf.Template("No Program List to display"))
    .Pageable(pageable => pageable.PageSizes(new[] { 5, 10, 20, 100, 200 }).ButtonCount(5))
    .Sortable()
    .Scrollable(s => s.Height("auto"))
    .DataSource(dataSource => dataSource
        .Ajax()
        .Read(read => read.Url(Url.Content("~/core/program/read")))
        .PageSize(10)
        .Sort(sort => sort.Add("CREATED_DATE").Descending())
    )
)

<style>
    .action-btn-group {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 2px; /* jarak antar button */
    }

    .action-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 4px;
        cursor: pointer;
    }

        .action-btn:hover {
            opacity: 0.75;
        }

</style>