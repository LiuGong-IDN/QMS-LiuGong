@using QCard.ManagementSystem.Domain.Modules.Core.ViewModel
@model QCard.ManagementSystem.Domain.Modules.Core.ViewModel.BasicDataResponse

@section scripts {
    @Html.Partial("~/Areas/Core/Views/Program/Script/_ProgramView.cshtml")
}

<form id="ProgramForm" method="post">
    @Html.AntiForgeryToken()

    <div class="portlet light margin-bottom-0">
        <!-- Machine Detail -->
        <div class="row">
            <div class="col-xs-6">
                <div class="page-head">
                    <div class="page-title">
                        <h1><span><b>Program Detail</b></span></h1>
                    </div>
                </div>
            </div>
            <div class="col-xs-6 text-right">
                <button type="button"
                        class="btn btn-reset"
                        onclick="history.back();">
                    <i class="fa fa-arrow-left mr-1"></i> Back
                </button>
            </div>
        </div>
        <br />

        <div class="portlet light bordered">
            <div class="portlet-body">
                @{
                    var program = Model.Data as QCard.ManagementSystem.Domain.Modules.Core.Model.ProgramModel;
                }
                <input type="hidden" id="programID" value="@program.ID" />
                <div class="row">
                    <!-- Bagian kiri: detail machine -->
                    <div class="col-md-6">
                        <div class="row">
                            <div class="col-md-4"><label><b>Program Code</b></label></div>
                            <div class="col-md-8"><label id="programCode">@program.PROGRAM_CODE</label></div>
                        </div>
                        <div class="row">
                            <div class="col-md-4"><label><b>Program Name</b></label></div>
                            <div class="col-md-8"><label id="programName">@program.PROGRAM_NAME</label></div>
                        </div>
                        <div class="row">
                            <div class="col-md-4"><label><b>Product Group</b></label></div>
                            <div class="col-md-8"><label id="machineType">@program.MACHINE_TYPE</label></div>
                        </div>
                        <div class="row">
                            <div class="col-md-4"><label><b>Product Model</b></label></div>
                            <div class="col-md-8"><label id="model">@program.MODEL_NAME</label></div>
                        </div>
                        <div class="row">
                            <div class="col-md-4"><label><b>Priority</b></label></div>
                            <div class="col-md-8"><label id="priority">@program.PRIORITY</label></div>
                        </div>
                    </div>

                    <!-- Bagian kanan: area gambar -->
                    <div class="col-md-6 text-center">
                        <div id="MachineImageArea" class="border p-2">
                            <img id="MachineImagePreview" class="img-thumbnail" style="max-width:100%; height:auto;" src="@Url.Content(program.IMAGE_PATH ?? "~/img/liugongQcard.png")" />
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Material Detail -->
        <div class="row">
            <div class="col-xs-6">
                <div class="page-head">
                    <div class="page-title">
                        <h1><span><b>Material Detail</b></span></h1>
                    </div>
                </div>
            </div>
        </div>
        <br />
        @await Html.PartialAsync("~/Areas/Core/Views/Program/Grid/_MaterialGrid.cshtml")
    </div>
</form>

<style>
    .row + .row {
        margin-top: 10px;
    }
</style>
<script>
    $(document).ready(function () {
        App.ProgramViewManagement = new ProgramViewManagement();
        App.ProgramViewManagement.InitManagement();
    });
</script>
