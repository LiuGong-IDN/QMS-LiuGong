<script type="text/javascript">
    var SourceDataLocCodes = [];
    var tempUL = "";
    var Id = "";

    function ProgramManagement() {
        return {
            InitManagement: function () {
                this.InitControls();
                this.InitValidation();
                this.InitHandlers();
            },
            InitControls: function () {
                $("input.text-uppercase").on("input", function () {
                    this.value = this.value.toUpperCase();
                });

                $("input.no-space-input").on("input", function () {
                    this.value = this.value.replace(/\s+/g, "");
                });

                $("#MODEL_ID-FILTER").kendoDropDownList({
                    dataTextField: "Text",
                    dataValueField: "Value",
                    dataSource: {
                        transport: {
                            read: {
                                cache: false,
                                url: "@Url.Content("~/Core/DataSource/GetModelList")",
                                dataType: "json"
                            },
                        },
                    },
                    
                    index: 0,
                    filter: "contains",
                    suggest: true,
                    optionLabel: "Select product model..."
                });
            },
            InitValidation: function () {
            },
            InitHandlers: function () {
                window.addEventListener("pageshow", function (event) {
                    if (event.persisted || performance.getEntriesByType("navigation")[0].type === "back_forward") {
                        $.helper.grid.refresh("ProgramGrid");
                    }
                });
                $("#btnClear").on("click", function (e) {
                    e.preventDefault();

                    var $form = $(this).closest("form");

                    $form.find("input[type='text']").val("");

                    var ddl = $("#MODEL_ID-FILTER").data("kendoDropDownList");
                    if (ddl) {
                        ddl.value("");       // kosongkan value
                        ddl.select(0);       // kembali ke optionLabel
                    }

                });
                $("#btnAddProgram").unbind('click').on('click', function (e) {
                    e.preventDefault();
                    window.location.href = "/Core/Program/AddProgram";
                });

                $(".k-grid").on('click', ".k-grid-delete", function () {
                    var $el = $(this),
                        $tr = $el.closest("tr"),
                        $grid = $el.closest(".k-grid").data("kendoGrid");


                    Id = $el.data('id');
                    Swal.fire({
                        title: "Delete this data?",
                        icon: "warning",
                        showCancelButton: true,
                        confirmButtonColor: "#3085d6",
                        cancelButtonColor: "#d33",
                        confirmButtonText: "Yes, delete it!"
                    }).then((result) => {
                        if (result.isConfirmed) {
                            $.ajax({
                                url: "@Url.Content("~/Core/Program/Delete")",
                                type: "POST",
                                data: {id : Id},
                                success: function (res) {
                                    if (res.Success == false || res.Success == "false") {
                                        Swal.fire({
                                            icon: "error",
                                            title: "Error",
                                            text: res.Message
                                        });
                                    } else {
                                        Swal.fire("Success!", "", "success");
                                        $.helper.grid.refresh("ProgramGrid");
                                    }
                                }
                            })
                            .fail(function (xhr, status, err) {
                                Swal.fire({
                                    icon: "error",
                                    title: "Error",
                                    text: `${status}: ${xhr.responseText || err}`
                                });
                            });
                        }
                    });
                });
            }
        };
    }

    $.helper.form.fill = function ($form, dataItem, excludeIds) {
        $form.find(':input').each(function () {
            let id = $(this).attr('id');

            // Skip kalau ID masuk daftar exclude
            if (excludeIds && excludeIds.includes(id)) {
                return; // lanjut ke elemen berikutnya
            }

            // Isi sesuai dataItem
            if (id && dataItem[id] !== undefined) {
                $(this).val(dataItem[id]);
            }
        });
    };
</script>
