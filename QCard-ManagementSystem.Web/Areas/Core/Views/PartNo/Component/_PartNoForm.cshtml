@model QCard.ManagementSystem.Domain.Modules.Core.ViewModel.PartNoView
<div id="PartNoModal" class="modal fade bs-modal-lg" abindex="-1" role="dialog" aria-hidden="true" style="display: none;">
    <div class="modal-dialog" style="min-width: 50%">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title"><label id="modalTitle"><b>Regiter Q-Card</b></label></h4>
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true"></button>
            </div>
            <div class="modal-body">
                <form id="modelForm">
                    <input type="hidden" id="ID" data-bind="value: ID" />
                    <div class="form-group row align-items-center mb-2">
                        <label class="col-sm-3 col-form-label fw-bold"><b>Part No.</b></label>
                        <div class="col-sm-9">
                            <input type="text" name="PART_NO" id="PART_NO" class="form-control text-uppercase no-space" value="" />
                            <span class="text-danger id"></span>
                        </div>
                    </div>

                    <div class="form-group row align-items-center mb-2">
                        <label class="col-sm-3 col-form-label fw-bold"><b>Part Name</b></label>
                        <div class="col-sm-9">
                            <input type="text" name="PART_NAME" id="PART_NAME" class="form-control text-uppercase" value="" />
                            <span class="text-danger id"></span>
                        </div>
                    </div>
                    <div class="form-group row align-items-center mb-2">
                        <label class="col-sm-3 col-form-label fw-bold"><b>Retail Price</b></label>
                        <div class="col-sm-9">
                            <input type="text" name="RETAIL_PRICE" id="RETAIL_PRICE" class="form-control no-space thousand-separator" value="" />
                            <span class="text-danger id"></span>
                        </div>
                    </div>
                </form>

                <div class="modal-footer">
                    <div class="row">
                        <button type="button" class="btn btn-reset btn-sm" data-dismiss="modal"><i class="fa fa-times mr-1"></i> Close</button>
                        <button type="button" class="btn blue trigger btn-sm" id="btnSavePartNo"><i class="fa fa-save"></i>&nbsp;Save</button>
                        <button type="button" class="btn blue trigger btn-sm" id="btnUpdatePartNo"><i class="fa fa-save"></i>Update</button>
                        @* <button type="button" class="btn btn-sm btn-outline-brand btn-square" data-dismiss="modal"><i class="fa fa-arrow-left"></i>Back</button> *@
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

