@using Newtonsoft.Json
@using QCard.ManagementSystem.Domain.Modules.Core.ViewModel
@using QCard.ManagementSystem.Domain.Modules.QCard.Model
@using QCard.ManagementSystem.Infrastructure.Session
@using System.Globalization
@model QCard.ManagementSystem.Domain.Modules.Core.ViewModel.BasicDataResponse

@section scripts {
    @await Html.PartialAsync("~/Areas/QCard/Views/ClaimProcess/Script/_ClaimProcessVoucherDetail.cshtml")
}
@section modals {
    @await Html.PartialAsync("~/Areas/QCard/Views/ClaimProcess/Component/RejectReason.cshtml")
    @await Html.PartialAsync("~/Areas/QCard/Views/ClaimProcess/Component/ProgramDetail.cshtml")
}

<div class="portlet light margin-bottom-0">
    @{
        var data = Model.Data as ClaimProcessDetail;
        var claimData = data.Header;
        var programDetail = data.ProgramDetail;
    }
    <!--Page Header-->
    <div class="row">
        <div class="col-xs-6">
            <div class="page-head">
                <div class="page-title">
                    <h1>
                        <span>Claim Detail</span>
                    </h1>
                </div>
            </div>
        </div>
        <div class="col-xs-6 text-right">
            <button type="button"
                    class="btn btn-reset"
                    onclick="window.location.href='/Qcard/CLaimProcess/Index'">
                <i class="fa fa-arrow-left mr-1"></i> Back
            </button>
        </div>
    </div>
    <br />

    <!--Content Header-->
    <div class="portlet light bordered">
        <div class="portlet-body">
            <input type="hidden" id="claimId" value="@claimData.CLAIM_ID" />
            <input type="hidden" id="currentVoucherAmount" value="Rp @claimData.CURRENT_AMOUNT.ToString("N0", new CultureInfo("id-ID"))" />
            <input type="hidden" id="latestGrandTotal" value="Rp @claimData.GRAND_TOTAL.ToString("N0", new CultureInfo("id-ID"))" />
            <input type="hidden" id="claimPpn" value="@claimData.PPN" />
            <input type="hidden" id="unConfirmDn" value="@claimData.UNCONFIRM_DN" />
            <div class="row">
                <div class="col-md-12">
                    <div class="row">
                        <div class="col-md-12">
                            <div class="row detail-container">
                                <div class="col-md-6 header-details">
                                    <div class="detail-item">
                                        <label class="detail-label">Claim No.</label>
                                        <input type="hidden" id="claimNo" value="@claimData.CLAIM_NO" />
                                        <span class="detail-value">@claimData.CLAIM_NO</span>
                                    </div>
                                    <div class="detail-item">
                                        <label class="detail-label">Claim Date</label>
                                        <span class="detail-value">@claimData.CLAIM_DATE?.ToString("dd-MMM-yyyy hh:mm:ss")</span>
                                    </div>
                                    <div class="detail-item">
                                        <label class="detail-label">Status</label>
                                        <input type="hidden" id="dataStatus" value="@claimData.STATUS_ID" />
                                        <span id="status" class="detail-value">@claimData.STATUS</span>
                                    </div>
                                    <div class="detail-item">
                                        <label class="detail-label">Serial No.</label>
                                        <span class="detail-value">@claimData.SERIAL_NO</span>
                                    </div>
                                    <div class="detail-item">
                                        <label class="detail-label">Product Group</label>
                                        <span class="detail-value">@claimData.ASSET_TYPE_NAME</span>
                                    </div>
                                    <div class="detail-item">
                                        <label class="detail-label">Product Model</label>
                                        <span class="detail-value">@claimData.MODEL_NAME</span>
                                    </div>
                                    <div class="detail-item">
                                        <label class="detail-label">Category Claim</label>
                                        <span class="detail-value">@claimData.CATEGORY_CLAIM</span>
                                    </div>
                                    <div class="detail-item">
                                        <label class="detail-label">Purchase Date</label>
                                        <span class="detail-value">@claimData.PURCHASE_DATE?.ToString("dd-MMM-yyyy")</span>
                                    </div>
                                    <div class="detail-item">
                                        <label class="detail-label">Service Party</label>
                                        <span class="detail-value">@claimData.SERVICE_PARTY_NAME</span>
                                    </div>
                                    <div class="detail-item">
                                        <label class="detail-label">Branch</label>
                                        <span class="detail-value">@claimData.BRANCH</span>
                                    </div>
                                    <div class="detail-item">
                                        <label class="detail-label">PDC</label>
                                        <span class="detail-value">@claimData.PDC_NAME</span>
                                    </div>
                                </div>
                                <!-- Gambar -->
                                <div class="col-md-6">
                                    <div class="bg-white d-flex">
                                        <img src="@Url.Content(claimData.IMAGE_PATH ?? "~/img/liugongQcard.png")"
                                             class="img-thumbnail"
                                             alt="Machine Image" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!--Grid Detail-->
    <div class="row">
        <div class="col-xs-6">
            <div class="page-head">
                <div class="page-title">
                    <h1>
                        <span>Claim Voucher Detail</span>
                    </h1>
                </div>
            </div>
        </div>
    </div>
    <br />

    @{
        if (SessionManager.HasRoleLike("admin"))
        {
            @await Html.PartialAsync("~/Areas/QCard/Views/ClaimProcess/Grid/_ClaimProcessVoucherDetailGridAdmin.cshtml")
        }
        else
        {
            @await Html.PartialAsync("~/Areas/QCard/Views/ClaimProcess/Grid/_ClaimProcessVoucherDetailGrid.cshtml")
        }
    }
    <br />
    @{
        @if (claimData.STATUS_ID == 6 && (SessionManager.HasRoleLike("PDC") || SessionManager.HasRoleLike("admin")))
        {
            <form id="formProcess">
                @Html.AntiForgeryToken()
                <input type="hidden" id="claimStatusId" value="@claimData.STATUS_ID" />
                <div class="row">
                    <div class="col-md-6">
                        <!-- batas lebar box -->
                        <div class="portlet light bordered">
                            <div class="portlet-body">
                                <div class="form-group row">
                                    <label class="col-md-4">Shipping Notes</label>
                                    <div class="col-md-8">
                                        <textarea class="form-control"
                                          disabled
                                          style="height:80px;">@claimData.SHIPPING_NOTES</textarea>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 text-right">
                                <div class="form-group">
                                    <a class="btn blue trigger" id="btnClaimProcess">
                                        <i class="fa fa-floppy-o"></i> <span class="hidden-xs">Update</span>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        }
    }
    <div class="row">
        @{
