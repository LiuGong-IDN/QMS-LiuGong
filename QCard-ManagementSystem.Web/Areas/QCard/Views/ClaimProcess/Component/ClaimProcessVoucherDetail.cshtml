        @{
            if(SessionManager.HasRoleLike("admin"))
            {
                <div id="claimSummary" class="claim-summary col-md-5 col-md-offset-7">
                    <div class="portlet light bordered">
                        <div class="portlet-body">
                            <div class="row">
                                <div class="col-xs-12">
                                    <div class="page-head">
                                        <div class="page-title">
