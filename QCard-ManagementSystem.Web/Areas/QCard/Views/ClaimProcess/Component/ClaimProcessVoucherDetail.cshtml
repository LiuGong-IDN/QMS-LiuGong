                            </div>
                            <div class="row">
                                <div class="col-md-5 text-right" style="justify-content:end; align-items:center;">
                                    <label for="grandTotal">Grand Total</label>
                                </div>
                                <div class="col-md-7">
                                    <div class="form-group">
                                        <input type="text" id="grandTotal" name="grandTotal" class="form-control text-right" style="width: 100%;" disabled="disabled" value="Rp @claimData.GRAND_TOTAL.ToString("N0", new CultureInfo("id-ID"))" />
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-5 text-right" style="justify-content:end; align-items:center;">
                                    <label for="reminingBalance">Remaining Balance</label>
                                </div>
                                <div class="col-md-7">
                                    <div class="form-group">
                                        <input type="text" id="reminingBalance" name="reminingBalance" class="form-control text-right" style="width: 100%;" disabled="disabled" value="Rp @claimData.CURRENT_AMOUNT.ToString("N0", new CultureInfo("id-ID"))" />
                                    </div>
                                </div>
                            </div>
                            @{
                                if (claimData.STATUS_ID == 9 && SessionManager.Roles?.Contains("QCARD-ADMIN", StringComparer.OrdinalIgnoreCase) == true)
                                {
                                    <div id="claimAction" class="claim-action">
                                        <div class="row">
                                            <div class="col-md-12 text-right">
                                                <div class="form-group">
                                                    <a class="btn btn-default blue trigger" id="btnVerifyClaim">
                                                        <i class="fa fa-floppy-o"></i> <span class="hidden-xs">Approve</span>
                                                    </a>
                                                    <a class="btn btn-success" id="btnReject">
                                                        <i class="fa fa-times"></i> <span class="hidden-xs">Reject</span>
                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>
            }
        }
    </div>
    <div class="portlet-body" style="padding-top:15px;">
        <div class="row">
            <div class="col-xs-6">
                <div class="page-head">
                    <div class="page-title">
                        <h1>
                            <span>Status History</span>
                        </h1>
                    </div>
                </div>
            </div>
        </div>
        <br />
        @await Html.PartialAsync("~/Areas/QCard/Views/ClaimProcess/Grid/_ClaimStatusHistoryGrid.cshtml")
    </div>
</div>
<script>
    var programDetailData = @Html.Raw(JsonConvert.SerializeObject(programDetail));
</script>