@using Kendo.Mvc.UI;

<div id="UpdateQtyModal" class="modal fade bs-modal-lg" abindex="-1" data-backdrop="static" data-keyboard="false" role="dialog" aria-hidden="true" style="display: none;">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">Update Qty Confirmation</h4>
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true"></button>
            </div>

            <div class="modal-body">
                <form id="formProcess">
                    @Html.AntiForgeryToken()
                    <div class="row">
                        <div class="col-md-12">
                            <div class="row">
                                <div class="form-group">
                                    <div class="col-md-12">
                                        <label for="newDnNumber">Delivery Note No.</label>
                                        <div>
                                            <span class="text-muted" style="font-style: italic; margin-bottom: 10px;">
                                                *) Partial pick-up has been completed for some parts. Please enter a new Delivery Note.
                                            </span>
                                        </div>
                                        <div class="form-group">
                                            <input type="text" id="newDnNumber" name="newDnNumber" class="form-control text-uppercase reff-input" />
                                            <span class="text-danger" id="DELIVERY_NOTE_NO"></span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12">
                            <div class="text-right pull-right">
                                <a class="btn blue trigger" id="btnConfirmUpdatePartClaimQty">
                                    <i class="fa fa-floppy-o"></i> <span class="hidden-xs">Update QTY</span>
                                </a>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
