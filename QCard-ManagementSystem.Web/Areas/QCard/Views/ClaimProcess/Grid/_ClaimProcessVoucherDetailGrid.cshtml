@using QCard.ManagementSystem.Domain.Modules.Core.ViewModel;
@using QCard.ManagementSystem.Domain.Modules.QCard.Model
@(Html.Kendo().Grid<ClaimProcessDetailProgram>()
    .Name("ClaimProcessVoucherDetailGrid")
    .Columns(columns =>
    {
        columns.Bound(o => o.CLAIM_DETAIL_ID)
            .Title("Details")
            .Sortable(false)
            .Width(75)
            .HtmlAttributes(new { @class = "text-center", style = "overflow: visible;" })
            .Filterable(false)
            .ClientTemplate(
            @"<a class=""k-grid-edit btnDetail cursor-pointer""
                data-claimdetailid='#: CLAIM_DETAIL_ID#'
                data-id='#: PROGRAM_ID#'
                data-name='#: PROGRAM_NAME#'
                title=""Detail"">
                <i class=""fa fa-file fa-lg""></i>
            </a>"
        );
        columns.Bound(o => o.PART_NO).Title("Part No.").Width(150);
        columns.Bound(o => o.PART_NAME).Title("Description").Width(170);
        columns.Bound(o => o.RETAIL_PRICE).Title("Retail Price").Width(100)
            .HtmlAttributes(new { @class = "retailPrice", style = "text-align:right; white-space:normal" })
            .ClientTemplate("Rp #= kendo.toString(RETAIL_PRICE, 'n0').replace(/,/g, '.') #");
        columns.Bound(o => o.CLAIM_QTY).Title("Claim Qty").Width(60).HtmlAttributes(new { style = "text-align:right;" });
        columns.Template(
            @"#
                if (AVAILABLE_QTY == 0) { #
                    Back Order
                # } else if (AVAILABLE_QTY < TOTAL_CLAIM_QTY) { #
                    Partial Back Order
                # } else if (AVAILABLE_QTY == TOTAL_CLAIM_QTY) { #
                    Available
                # } else { #
                    -
                # }
            #"
        )
        .HtmlAttributes(new { @class = "statusCell", style = "text-align:center;" })
        .Title("Status")
        .Width(100);
        columns.Bound(o => o.AVAILABLE_QTY)
            .Title("Available Qty")
            .Width(90)
            .ClientTemplate(
                @"<input type='number' min='1'
                    class='availableQty form-control is-number'
                    style='width:70%; height:80%; text-align:right; margin:auto;'
                    value='#: AVAILABLE_QTY #'
                    data-total='#: CLAIM_QTY #'
                />"
            );
        columns.Bound(o => o.BACK_ORDER_QTY)
            .Title("Back Order Qty")
            .Width(70)
            .HtmlAttributes(new { @class = "backOrderCell", style = "text-align:right;" });

        columns.Bound(o => o.UPDATED_DATE)
            .Title("Updated Date")
            .Width(110)
            .ClientTemplate("#= UPDATED_DATE ? kendo.toString(kendo.parseDate(UPDATED_DATE), 'dd-MMM-yyyy HH:mm:ss') : '' #");
        columns.Bound(o => o.PARTIAL_CONFIRMATION_DATE)
            .Title("Last Confirmation Date")
            .Width(150)
            .ClientTemplate("#= PARTIAL_CONFIRMATION_DATE ? kendo.toString(kendo.parseDate(PARTIAL_CONFIRMATION_DATE), 'dd-MMM-yyyy HH:mm:ss') : '' #");
        columns.Bound(o => o.PGI).Title("PGI").Width(90);
    })
    .Reorderable(r => r.Columns(true))
    .Resizable(r => r.Columns(true))
    .NoRecords(conf => conf.Template("No Part Claim to display"))
    .Events(events => events.DataBound("onClaimVoucherGridDataBound"))
    .Sortable()
    .Scrollable(s => s.Height("auto"))
    .AutoBind(true)
)