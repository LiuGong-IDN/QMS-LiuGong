@using QCard.ManagementSystem.Domain.Modules.Core.ViewModel;
@using QCard.ManagementSystem.Domain.Modules.QCard.Model
@(Html.Kendo().Grid<ClaimProcessDetailProgram>()
    .Name("ClaimProcessVoucherDetailGrid")
    .Columns(columns =>
    {
        columns.Bound(o => o.PART_ID).Hidden();
        columns.Bound(o => o.PART_NO).Title("Part No.").Width(100);
        columns.Bound(o => o.PART_NAME).Title("Description").Width(120);
        columns.Bound(o => o.RETAIL_PRICE).Title("Retail Price").Width(130)
        .HtmlAttributes(new { @class = "retailPrice", style = "text-align:right; white-space:normal" })
            .ClientTemplate("Rp #= kendo.toString(RETAIL_PRICE, 'n0').replace(/,/g, '.') #");
        columns.Bound(o => o.CLAIM_QTY).Title("Claim Qty").Width(100)
            .HtmlAttributes(new { @class = "text-center", style = "overflow: visible; padding-left: 0px;padding-right: 0px;" })
            .Filterable(false)
            .ClientTemplate(
                @"<input disabled='disabled' type='number'
                    class='claimQty form-control'
                    style='width:70%; height:70%; text-align: right; margin:auto;'
                    value='#: CLAIM_QTY #'
                />"
            );
        columns.Bound(o => o.PRICE_BEFORE_DISC).Title("Sub-total").Width(120)
            .HtmlAttributes(new { @class = "subTotal text-center", style = "overflow: visible; padding-left: 0px;padding-right: 0px;" })
            .ClientTemplate("Rp #= kendo.toString(PRICE_BEFORE_DISC, 'n0').replace(/,/g, '.') #");
        columns.Bound(o => o.DISCOUNT).Title("Discount (%)").Width(100)
            .HtmlAttributes(new { @class = "text-center", style = "overflow: visible; padding-left: 0px;padding-right: 0px;" })
            .Filterable(false)
            .ClientTemplate(
                @"<input type='number'
                    class='discountField form-control'
                    style='width:70%; height:70%; text-align: right; margin:auto;'
                    value='#: DISCOUNT #'
                />"
            );
        columns.Bound(o => o.DISCOUNT_TOTAL_PRICE).Title("Total").Width(100)
        .HtmlAttributes(new { @class = "text-center discountTotalPrice", style = "overflow: visible; padding-left: 0px;padding-right: 0px;" })
        .Filterable(false)
        .ClientTemplate("Rp #= kendo.toString(DISCOUNT_TOTAL_PRICE, 'n0').replace(/,/g, '.') #");
        
    })
    .Reorderable(r => r.Columns(true))
    .Resizable(r => r.Columns(true))
    .NoRecords(conf => conf.Template("No Part Claim to display"))
    .Events(events => events.DataBound("onClaimVoucherGridDataBound"))
    .Sortable()
    .Scrollable(s => s.Height("auto"))
    .AutoBind(true)
)