    function buildDataToSave(claimId) {
        var formValues = {};
        var claimNo = $("#claimNo").val();
        let hasPositiveAvailableQty = false;

        $('#formProcess input:not([type="hidden"]), #formProcess textarea, #formProcess select').each(function() {
            var id = $(this).attr('id');
            var value = $(this).val();
            formValues[id] = value;
        });
        var raw = $("#latestGrandTotal").val() || "";

        var grandTotal = parseInt(
            raw.replace(/[^\d]/g, ""), // hapus Rp, spasi, titik
            10
        ) || 0;
        var claimStatusId = $("#claimStatusId").val();
        var ddlStatus = $("#claimStatus").data("kendoDropDownList");
        var actionName = '';
        if(ddlStatus)
        {
            var item = ddlStatus.dataItem();
            actionName = item ? item.Name : null;
        }
        if (!actionName && claimStatusId) {
            const statusMap = {
                6: "Received"
            };
            actionName = statusMap[claimStatusId] || null;
        }

        var grid = $("#ClaimProcessVoucherDetailGrid").data("kendoGrid");
        var gridData = [];
        var isValid = true; // flag untuk validasi

        grid.tbody.find("tr").each(function () {
            var dataItem = grid.dataItem(this);
            var availableQty = parseFloat($(this).find(".availableQty").val()) || 0;
            var claimQty = parseFloat(dataItem.CLAIM_QTY) || 0;

            if (typeof actionName === "string" && actionName.toLowerCase() !== "reject") {
                // --- VALIDASI DI SINI ---
                if (availableQty > claimQty) {
                    Swal.fire({
                        icon: "error",
                        title: "Invalid Quantity",
                        html: `Available Quantity (<b>${availableQty}</b>) cannot exceed Claim Quantity (<b>${claimQty}</b>) for part <b>${dataItem.PART_NO}</b>.`,
                        confirmButtonText: "OK"
                    });
                    isValid = false;
                    return false; // exit the .each() loop
                }

                // Koleksi apakah ada yg > 0
                if (availableQty > 0) {
                    hasPositiveAvailableQty = true;
                }
            }

            var backOrderQty = claimQty - availableQty;
            if (backOrderQty < 0) backOrderQty = 0;

            gridData.push({
                CLAIM_NO: claimNo,
                CLAIM_DETAIL_ID: dataItem.CLAIM_DETAIL_ID,
                PART_NO: dataItem.PART_NO,
                PART_NAME: dataItem.PART_NAME,
                CLAIM_QTY: claimQty,
                AVAILABLE_QTY: availableQty,
                BACK_ORDER_QTY: backOrderQty
            });
        });

        if (!isValid) return null; // batalkan jika invalid

        // === VALIDASI GLOBAL: Minimal 1 availableQty > 0 ===
        if (typeof actionName === "string" && actionName.toLowerCase() !== "reject" && actionName.toLowerCase() !== "received") {
            if (!hasPositiveAvailableQty) {
                Swal.fire({
                    icon: "error",
                    title: "Invalid Quantity",
                    html: `At least <b>1 Available Quantity</b> must be greater than 0.`,
                    confirmButtonText: "OK"
                });
                return null;
            }
        }
        var dataToSave = {
            claimNo: claimNo,
            claimId: claimId,
            Grand_Total: grandTotal,
            actionName: actionName,
            ...formValues,
            ProgramDetails: gridData
        };

        // TAMBAHKAN MAPPING INI
        if (formValues.SpbNotes !== undefined) {
            dataToSave.NOTES = formValues.SpbNotes;
            delete dataToSave.SpbNotes;
        }

        return dataToSave;
    }

    function postUpdateQty(dataToSave) {
        console.log(dataToSave);
        $.ajax({
            url: "/QCard/ClaimProcess/UpdatePartClaimQty",
            type: "POST",
            data: JSON.stringify(dataToSave),
            contentType: "application/json",
            success: function (res) {
                if (!res.Success) {
                    if (!res.Validate) {
                        ShowErrorMessage($form, JSON.parse(res.Message));
                    } else {
                        Swal.fire({
                            title: "Error",
                            text: res.Message,
                            icon: "error"
                        });
                    }
                } else {
                    Swal.fire({
                        icon: "success",
                        title: "Success"
                    }).then((result) => {
                        if (result.isConfirmed) {
                            window.location.href = "/QCard/ClaimProcess/Index";
                        }
                    });
                }
            }
        })
        .fail(function (xhr, status, err) {
            Swal.fire({
                icon: "error",
                title: "Error",
                text: `${status}: ${xhr.responseText || err}`
            });
        });
    }

    function mergeCellProgramDetailGrid() {
        var grid = $("#ProgramDetailHistoryGrid").data("kendoGrid");
        if (grid) {
            grid.bind("dataBound", function () {

                const rows = this.tbody.find("tr");
                const mergeColumns = [0,1,5,6,7,8];  // kolom yang ingin di-merge
                const sortedColumns = mergeColumns.slice().sort((a, b) => b - a); // sort desc

                sortedColumns.forEach(function (colIndex) {
                    let prevText = null;
                    let prevCell = null;

                    rows.each(function () {
                        const cell = $(this).find("td").eq(colIndex);
                        const text = cell.text().trim();

                        if (!text) {
                            prevText = null;
                            prevCell = null;
                            return;
                        }

                        if (prevText === text) {
                            // increment rowspan
                            prevCell[0].rowSpan++;
                            cell.remove();
                        } else {
                            prevText = text;
                            prevCell = cell;
                        }
                    });
                });
            });

            // trigger jika ada data
            if (grid.dataSource.view().length > 0) {
                grid.trigger("dataBound");
            }
        } else {
            setTimeout(function () {
                ClaimProcessManagement.InitValidation();
            }, 500);
        }
    }

    function handleShippingAgentChange() {
        var selectedText = $("#ShippingAgent").data("kendoDropDownList").text().toUpperCase();
        var divSpbNotes = $('#divSpbNotes');
        var spbNotesInput = $('#SpbNotes');

        if (selectedText.includes("SELF") || selectedText.includes("PICKUP")) {
            divSpbNotes.show();
            spbNotesInput.prop('required', true);
        } else {
            divSpbNotes.hide();
            spbNotesInput.prop('required', false).val('');
        }
    }
</script>