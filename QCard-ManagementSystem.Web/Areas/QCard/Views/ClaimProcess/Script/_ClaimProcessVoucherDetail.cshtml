    function toRupiah(value) {
        if (value == null || value === "") return "Rp 0";
        return "Rp " + new Intl.NumberFormat("id-ID", {
            minimumFractionDigits: 0,
            maximumFractionDigits: 0
        }).format(value);
    }

    function parseRupiah(str) {
        if (!str) return 0;
        str = str.replace(/[^0-9\-]/g, ""); // biarkan minus
        return parseInt(str) || 0;
    }

    function updateTotalPrice(input) {
        var discount = parseFloat(input.val()) || 0;

        if(discount < 0) {
            $(input).val(0);
            discount = 0;
        }
        if(discount > 100) {
            $(input).val(100);
            discount = 100;
        }

        var row = input.closest("tr");
        row.find(".discountField").text(discount);

        var subTotalRow = row.find(".subTotal").text();
        var subTotalValue = parseRupiah(subTotalRow)

        let discountTotal = subTotalValue - (subTotalValue * (discount / 100));
        row.find(".discountTotalPrice").text(toRupiah(discountTotal));

        calculateSummary();
    }

    function calculateSummary() {
        let claimPpn = parseFloat($("#claimPpn").val()) || 0;
        let claimAmount = parseFloat(getClaimAmount()) || 0;
        let ppn = Math.round(claimAmount * claimPpn / 100);


        let currentVoucherAmount = parseRupiah($("#currentVoucherAmount").val());
        let latestGrandTotal =  parseRupiah($("#latestGrandTotal").val());
        let voucherWhenClaim = currentVoucherAmount + latestGrandTotal;

        let grandTotal = claimAmount + ppn;
        let remaining = voucherWhenClaim - (claimAmount + ppn);

        if (remaining < 0)
        {
            $("#btnVerifyClaim").hide();
        }
        else {
            $("#btnVerifyClaim").show();
        }

        $("#claimAmount").val(toRupiah(claimAmount));
        $("#grandTotal").val(toRupiah(grandTotal));
        $("#PPN").val(toRupiah(ppn));
        $("#reminingBalance").val(toRupiah(remaining));
    }

    function getClaimAmount() {
        let total = 0;

        $(".discountTotalPrice").each(function () {
            let text = $(this).text();
            let num = parseInt(text.replace(/[^0-9]/g, "")) || 0;
            total += num;
        });
        return total;
    }

    function updateRowValues(input) {
        var available = parseFloat(input.val()) || 0;
        var total = parseFloat(input.data("total")) || 0;

        if (available > total) {
            available = total;
            input.val(total);
        }

        var backOrder = total - available;
        if (backOrder < 0) backOrder = 0;

        var statusText = "";
        if (available === 0)
            statusText = "Back Order";
        else if (available < total)
            statusText = "Partial Back Order";
        else if (available === total)
            statusText = "Available";
        else
            statusText = "-";

        var row = input.closest("tr");
        row.find(".statusCell").text(statusText);
        row.find(".backOrderCell").text(backOrder);

        updateStatusDropdownBasedOnGrid();
    }
    function updateStatusDropdownBasedOnGrid() {
        const ddl = $("#claimStatus").data("kendoDropDownList");
        if (!ddl) return;

        const currentValue = ddl.value(); // simpan status sebelumnya

        let allValid = true;
        let hasBackOrder = false;

        $("#ClaimProcessVoucherDetailGrid .availableQty").each(function () {
            const available = parseFloat($(this).val()) || 0;
            const total = parseFloat($(this).data("total")) || 0;

            if (available !== total) {
                allValid = false;
            }

            if (available === 0 || available < total) {
                hasBackOrder = true;
            }
        });

        const ds = ddl.dataSource;
        const data = ds.data();

        // === HANDLE VALUE 7 (Pending) ===
        let item7 = data.find(x => x.Value == 7);

        if (allValid) {
            if (item7) {
                removedValue2Item = { ...item7 };  // SIMPAN SEMUA PROPERTY!
                ds.remove(item7);
            }
        } else {
            if (!item7 && removedValue2Item != null) {
                ds.add(removedValue2Item);         // PROPERTY NAME tetap ada
                removedValue2Item = null;
            }
        }

        // === HANDLE VALUE 4 (Preparing) ===
        let preparing = data.find(x => x.Value == 4);

        if (hasBackOrder) {
            if (preparing) {
                removedPreparingItem = { ...preparing };   // SIMPAN SEMUA PROPERTY!
                ds.remove(preparing);
            }
        } else {
            if (!preparing && removedPreparingItem != null) {
                ds.add(removedPreparingItem);              // PROPERTY NAME tetap ada
                removedPreparingItem = null;
            }
        }

        // Kembalikan nilai sebelumnya — tanpa refresh
        ddl.value(currentValue);
    }
    function filterClaimStatusDropdown() {
        const status = $("#dataStatus").val();
        $("#claimStatus").kendoDropDownList({
            dataTextField: "Text",
            dataValueField: "Value",
            dataSource: {
                transport: {
                    read: {
                        cache: false,
                        url: "@Url.Content("~/Core/DataSource/GetClaimProcessStatusList")",
                        dataType: "json",
                        data: function() {
                            return {
                                status: $("#dataStatus").val(),
                                filter: $("#claimStatus").data("kendoDropDownList").filterInput.val()
                            };
                        }
                    },
                },
            },
            //index: 0,
            filter: "contains",
            suggest: true,
            optionLabel: "Select Status..",
            dataBound: function () {
                const ddl = this;
                const data = ddl.dataSource.view();
                if (data && data.length < 2) {
                    ddl.value(data[0].Value);
                    this.enable(false)
                }
                else {
                    this.enable(true)
                }
                updateStatusDropdownBasedOnGrid();

            },
            select: function (e) {
                const dataItem = this.dataItem(e.item.index());
                if (dataItem && dataItem.disabled) {
                    e.preventDefault();
                }
            },
            change: function (e) {
                var ddl = this;
                ddl.close();
                var value = this.value();
                const divReason = document.getElementById('divReason');
                const divDnNumber = document.getElementById('divDnNumber');
                const divPgi = document.getElementById('divPgi');
                if (status == 2) {
                    if (value == 3) {
                        divReason.style.display = 'block';

                        divDnNumber.style.display = 'none';
                        $("#DnNumber").val("");
                    }
                    else {
                        divDnNumber.style.display = 'block';

                        divReason.style.display = 'none';
                        $("#ReasonReject").val("");
                    }
                }
                else if (status == 4) {
                    if (value == 3) {
                        divReason.style.display = 'block';

                        divPgi.style.display = 'none';
                    }
                    else {
                        divPgi.style.display = 'block';

                        divReason.style.display = 'none';
                        $("#DnNumber").val("");
                    }
                }
            }
        });
    }
