    function buildDataToSaveVerify(claimId) {
        var grid = $("#ClaimProcessVoucherDetailGrid").data("kendoGrid");
        var dataItems = grid.dataSource.view();
        var partList = [];

        $("#ClaimProcessVoucherDetailGrid tbody tr").each(function (i, row) {
            var dataItem = dataItems[i];

            var qty = $(row).find("input.claimQty").val();
            var discount = $(row).find("input.discountField").val() || 0;

            if (qty && parseInt(qty) > 0) {
                partList.push({
                    PART_ID: dataItem.PART_ID,
                    DISCOUNT: parseFloat(discount),
                    QTY: parseInt(qty)
                });
            }
        });
        return {
            CLAIM_ID: claimId,
            PART_LIST: partList
        };
    }

