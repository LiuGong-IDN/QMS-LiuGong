    function postUpdateQty(dataToSave) {
        console.log(dataToSave);
        $.ajax({
            url: "/QCard/ClaimProcess/UpdatePartClaimQty",
            type: "POST",
            data: JSON.stringify(dataToSave),
            contentType: "application/json",
            success: function (res) {
                if (!res.Success) {
                    if (!res.Validate) {
                        ShowErrorMessage($form, JSON.parse(res.Message));
                    } else {
                        Swal.fire({
                            title: "Error",
                            text: res.Message,
                            icon: "error"
                        });
                    }
                } else {
                    Swal.fire({
                        icon: "success",
                        title: "Success"
                    }).then((result) => {
                        if (result.isConfirmed) {
                            window.location.href = "/QCard/ClaimProcess/Index";
                        }
                    });
                }
            }
        })
        .fail(function (xhr, status, err) {
            Swal.fire({
                icon: "error",
                title: "Error",
                text: `${status}: ${xhr.responseText || err}`
            });
        });
    }
    function updateStatusDropdownBasedOnGrid() {
        const ddl = $("#claimStatus").data("kendoDropDownList");
        if (!ddl) return;

        const currentValue = ddl.value(); // simpan status sebelumnya

        let allValid = true;
        let hasBackOrder = false;

        $("#ClaimProcessProgramDetailGrid .availableQty").each(function () {
            const available = parseFloat($(this).val()) || 0;
            const total = parseFloat($(this).data("total")) || 0;

            if (available !== total) {
                allValid = false;
            }

            if (available === 0 || available < total) {
                hasBackOrder = true;
            }
        });

        const ds = ddl.dataSource;
        const data = ds.data();

        // === HANDLE VALUE 7 (Pending) ===
        let item7 = data.find(x => x.Value == 7);

        if (allValid) {
            if (item7) {
                removedValue2Item = { ...item7 };  // SIMPAN SEMUA PROPERTY!
                ds.remove(item7);
            }
        } else {
            if (!item7 && removedValue2Item != null) {
                ds.add(removedValue2Item);         // PROPERTY NAME tetap ada
                removedValue2Item = null;
            }
        }

        // === HANDLE VALUE 4 (Preparing) ===
        let preparing = data.find(x => x.Value == 4);

        if (hasBackOrder) {
            if (preparing) {
                removedPreparingItem = { ...preparing };   // SIMPAN SEMUA PROPERTY!
                ds.remove(preparing);
            }
        } else {
            if (!preparing && removedPreparingItem != null) {
                ds.add(removedPreparingItem);              // PROPERTY NAME tetap ada
                removedPreparingItem = null;
            }
        }

        // Kembalikan nilai sebelumnya — tanpa refresh
        ddl.value(currentValue);
    }


    function handleShippingAgentChange() {
        var selectedText = $("#ShippingAgent").data("kendoDropDownList").text().toUpperCase();
        var divSpbNotes = $('#divSpbNotes');
        var spbNotesInput = $('#SpbNotes');

        if (selectedText.includes("SELF") || selectedText.includes("PICKUP")) {
            divSpbNotes.show();
            spbNotesInput.prop('required', true);
        } else {
            divSpbNotes.hide();
            spbNotesInput.prop('required', false).val('');
        }
    }
