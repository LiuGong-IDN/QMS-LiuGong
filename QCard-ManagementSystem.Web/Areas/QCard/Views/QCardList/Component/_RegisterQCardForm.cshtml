@model QCard.ManagementSystem.Domain.Modules.QCard.ViewModel.QCardListView
<div id="QCardModal" class="modal fade bs-modal-lg" abindex="-1" role="dialog" aria-hidden="true" style="display: none;">
    <div class="modal-dialog" style="min-width: 50%">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title"><label id="modalTitle">Register Q-Card</label></h4>
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true"></button>
            </div>
            <div class="modal-body">
                <form id="qcardForm">
                    <input type="hidden" id="ID" data-bind="value: ID" />
                    <div class="form-group row align-items-center mb-2">
                        <label class="col-sm-4 col-form-label fw-bold"><b>Customer</b></label>
                        <div class="col-sm-8">
                            <input type="text" name="CUSTOMER_ID" id="CUSTOMER_ID" class="form-control" value="" />
                            <span class="text-danger id"></span>
                        </div>
                    </div>

                    <div class="form-group row align-items-center mb-2">
                        <label class="col-sm-4 col-form-label fw-bold"><b>Card No.</b></label>
                        <div class="col-sm-8">
                            <input type="text" name="CARD_NO" id="CARD_NO_VALUE" class="form-control" value="" maxlength="19" />
                            <span class="text-danger id"></span>
                        </div>
                    </div>

                    <div class="form-group row align-items-center mb-2">
                        <label class="col-sm-4 col-form-label fw-bold"><b>Valid Thru</b></label>
                        <div class="col-sm-4">
                            @Html.TextBoxFor(x => x.VALID_TO_MONTH, new { @class = "form-control", id = "VALID_TO_MONTH" })
                            <span class="text-danger"></span>
                        </div>
                        <div class="col-sm-4">
                            @Html.TextBoxFor(x => x.VALID_TO_YEAR, new { @class = "form-control", id = "VALID_TO_YEAR" })
                            <span class="text-danger"></span>
                        </div>
                    </div>
                </form>
                <div class="modal-footer">
                    <button type="button" class="btn btn-reset btn-sm" data-dismiss="modal"><i class="fa fa-times mr-1"></i>Close</button>
                    <button type="button" class="btn blue trigger btn-sm" id="btnSaveQCard"><i class="fa fa-save"></i>&nbsp;Save</button>
                    <button type="button" class="btn blue trigger btn-sm" id="btnUpdateQCard"><i class="fa fa-save"></i>Update</button>
                </div>
            </div>
        </div>
    </div>
</div>