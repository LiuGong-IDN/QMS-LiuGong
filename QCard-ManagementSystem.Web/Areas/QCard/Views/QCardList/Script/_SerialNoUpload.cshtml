<script>
    function SerialNoUploadManager(){
        return{
            InitManagement: function () {
                this.InitControl();
                this.InitHandlers();
                this.InitValidation();
            },
            InitControl: function () {
            },
            InitValidation: function () {
            },
            InitHandlers: function () {
                $("#fileUploadSerialNo").kendoUpload({
                    async: {
                        saveUrl: "@Url.Content("~/Core/DataSource/UploadExcel")",
                        autoUpload: true
                    },
                    validation: {
                        allowedExtensions: [".xlsx"]
                    },
                    select: function (e) {
                        if (e.files.length == 0) {
                            Swal.fire({
                                icon: "error",
                                title: "Error",
                                text: "No file has been uploaded"
                            });
                            return;
                        }
                        var data = new FormData();
                        for (var i = 0; i < e.files.length; i++) {
                            data.append("Upload", e.files[i].rawFile);
                        }

                        $.ajax({
                            url: "@Url.Content("~/QCard/QCardList/UploadProcess")",
                            type: 'POST',
                            contentType: false,
                            processData: false,
                            data: data,
                            success: function (res) {
                                if (res.isSaved == true) {
                                    $("#TempCode").val(res.tempCode);
                                    $('#SerialNoUploadGrid').data("kendoGrid").dataSource.read();

                                    if (res.canSubmit == false && res.message != null && res.message.trim() !== '') {
                                        Swal.fire({
                                            icon: "error",
                                            title: "Error",
                                            text: res.message || "An error occurred while uploading"
                                        });
                                        $("#btnDownloadErrorUpload").hide();
                                        $("#btnSubmitUpload").hide();
                                    }
                                    if (res.canSubmit == true) {
                                        $("#btnSubmitUpload").show();
                                        $("#btnDownloadErrorUpload").hide();
                                    }
                                    else {
                                        $("#btnDownloadErrorUpload").show();
                                        $("#btnSubmitUpload").hide();
                                    }
                                } else {
                                    $("#btnSubmitUpload").hide();
                                    $("#btnDownloadErrorUpload").hide();
                                    Swal.fire({
                                        icon: "error",
                                        title: "Error",
                                        text: res.message || "An error occurred while uploading"
                                    });
                                }
                            }
                        })
                        .fail(function (xhr, status, err) {
                            Swal.fire({
                                icon: "error",
                                title: "Error",
                                text: `${status}: ${xhr.responseText || err}`
                            });
                        });
                    },
                    success: function (e) {
                        console.log(e);
                    },
                    multiple: false,
                });

                $("#btnSubmitUpload").on('click', function (event) {
                    var $el = $(this),
                        $modal = $(this).closest(".modal");

                    var tempCode = $("#TempCode").val();
                    $.post("@Url.Content("~/QCard/QCardList/SubmitExcelUpload")", { tempCode: tempCode }, function (d) {
                        if (d.status === "Success") {
                            $modal.modal("hide");
                            removeAllRow();
                            Swal.fire("Success!", "", "success");
                            $.helper.grid.refresh("SerialNoUploadGrid");
                            loadUploadedDataSerialNo(tempCode);
                        } else {
                            Swal.fire({
                                icon: "error",
                                title: "Error",
                                text: d.message || "Upload failed. Please check your data."
                            });
                        }
                    })
                    .fail(function (xhr, status, err) {
                        Swal.fire({
                            icon: "error",
                            title: "Error",
                            text: `${status}: ${xhr.responseText || err}`
                        });
                    })
                    .always(function () {
                        $el.prop("disabled", false);
                    });
                });

                $("#btnDownloadErrorUpload").on('click', function (event) {
                    window.location.href = "@Url.Content("~/QCard/QCardList/DownloadExcelError?tempCode=")" + $("#TempCode").val();
                });
            },
        };
    }

    function sendTempCode() {
        return {
            tempCode: $("#TempCode").val()
        };
    }

    function loadUploadedDataSerialNo(tempCode) {
        var serialNoDataSource = new kendo.data.DataSource({
            transport: {
                read: {
                    url: "@Url.Content("~/Core/DataSource/GetSerialNoQCard")",
                    dataType: "json"
                }
            }
        });

        $.ajax({
            url: '/QCard/QCardList/GetUploadedSerialNo',
            type: 'GET',
            data: { tempCode: tempCode }, // kirim parameter ke server
            dataType: 'json',
            success: function (response) {
                var uploadedserialNo = response.Data;

                uploadedserialNo.forEach(function (p) {
                    var newRow = `
                        <tr>
                            <td class="text-center align-middle">
                                <a class="btnRemoveRow" title="Delete">
                                    <i class="fas fa-trash-alt fa-lg"></i>
                                </a>
                            </td>
                            <td>
                                <input name="SERIAL_NO[]" class="form-control serialNoDropdown" />
                                <input type="hidden" name="MACHINE_ID[]" value="${p.MACHINE_ID}" />
                            </td>
                            <td>
                                <input type="text" name="MACHINE_TYPE[]" class="form-control machinetypeField" value="${p.ASSET_TYPE_NAME}" readonly />
                            </td>
                            <td>
                                <input type="text" name="PRODUCT_MODEL[]" class="form-control productmodelField" value="${p.MODEL_NAME}" readonly/>
                            </td>
                            <td>
                                <input name="PURCHASE_DATE[]" class="form-control purchasedateField" value="${formatDate(p.PURCHASE_DATE)}" readonly/>
                            </td>
                        </tr>
                    `;

                    $("#SerialNoTable tbody").append(newRow);

                    // Inisialisasi dropdown di row yang baru ditambahkan
                    var $serialNoDropdown = $("#SerialNoTable tbody tr:last .serialNoDropdown").kendoDropDownList({
                        dataTextField: "Text",
                        dataValueField: "Value",
                        dataSource: serialNoDataSource,
                        filter: "contains",
                        optionLabel: "Select Serial No...",
                        change: function (e) {
                            var dataItem = this.dataItem(this.selectedIndex);
                            var $row = $(this.element).closest("tr");

                            var $machinetypeField = $row.find(".machinetypeField");
                            var $productmodelField = $row.find(".productmodelField");
                            var $purchasedateField = $row.find(".purchasedateField");
                            var $serialNoIdField = $row.find("input[name='MACHINE_ID[]']");
                            if (dataItem) {
                                $machinetypeField.val(dataItem.Name || "");
                                $productmodelField.val(dataItem.Value || "");
                                var date = new Date(dataItem.Date);
                                var formattedDate = date.toISOString().split('T')[0];
                                $purchasedateField.val(formattedDate);
                                $serialNoIdField.val(dataItem.Value || "");
                            } else {
                                $machinetypeField.val("");
                                $productmodelField.val("");
                                $purchasedateField.val("");
                                $serialNoIdField.val("");
                            }
                        }
                    }).data("kendoDropDownList");

                    // Set nilai dropdown sesuai data existing
                    if (p.MACHINE_ID) {
                        // Tunggu data source selesai di-load
                        $serialNoDropdown.one("dataBound", function () {
                            // console.log(p.PART_ID)
                            this.value(p.MACHINE_ID);
                        });
                    }
                });
            }
        })
        .fail(function (xhr, status, err) {
            Swal.fire({
                icon: "error",
                title: "Error",
                text: `${status}: ${xhr.responseText || err}`
            });
        });
    }

    $(document).ready(function () {
        SerialNoUploadManager = new SerialNoUploadManager();
        SerialNoUploadManager.InitManagement();
    });
    function formatDate(dateString) {
        if (!dateString) return "";

        const date = new Date(dateString);
        if (isNaN(date)) return "";

        // Format: 25-Jan-2025
        const day = String(date.getDate()).padStart(2, "0");
        const month = date.toLocaleString("en-GB", { month: "short" });
        const year = date.getFullYear();

        return `${day}-${month}-${year}`;
    }

</script>