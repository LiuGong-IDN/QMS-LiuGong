@using QCard.ManagementSystem.Domain.Modules.Core.ViewModel
@using System.Globalization
@model QCard.ManagementSystem.Domain.Modules.Core.ViewModel.BasicDataResponse

@section scripts {
    @Html.Partial("~/Areas/MyMachines/Views/MyMachines/Script/_MachinesDetailVoucher.cshtml")
}
@section modals {
    @await Html.PartialAsync("~/Areas/MyMachines/Views/MyMachines/Component/ProgramDetail.cshtml")
}

<div class="portlet light margin-bottom-0">
    <div class="row">
        <div class="col-xs-6">
            <div class="page-head">
                <div class="page-title">
                    <h1>
                        <span>Machine - Claim Voucher</span>
                    </h1>
                </div>
            </div>
        </div>
        <div class="col-xs-6 text-right">
            <button type="button"
                    class="btn btn-reset"
                    onclick="window.location.href='/MyMachines/MyMachines/Index'">
                <i class="fa fa-arrow-left mr-1"></i> Back
            </button>
        </div>
    </div>
    <br />

    <div class="portlet light bordered">
        <div class="portlet-body">
            @{
                var machine = Model.Data as Modules.MyMachines.Model.MachinesDetail;
                var currentAmountRaw = machine.CURRENT_AMOUNT;
            }
            <input type="hidden" id="machineID" value="@machine.ID" />
            <div class="row">
                <div class="col-md-12">
                    <div class="row detail-container">
                        <div class="col-md-6 header-details">
                            <div class="detail-item">
                                <label class="detail-label">Serial No.</label>
                                <span class="detail-value">@machine.SERIAL_NO</span>
                            </div>
                            <div class="detail-item">
                                <label class="detail-label">Product Group</label>
                                <span class="detail-value">@machine.MACHINE_TYPE</span>
                            </div>
                            <div class="detail-item">
                                <label class="detail-label">Product Model</label>
                                <span class="detail-value">@machine.MODEL</span>
                            </div>
                            <div class="detail-item">
                                <label class="detail-label">Purchase Date</label>
                                <span class="detail-value">@machine.PURCHASE_DATE.ToString("dd-MMM-yyyy")</span>
                            </div>
                            <div class="detail-item">
                                <label class="detail-label">Service Party</label>
                                <span class="detail-value">@machine.SERVICE_PARTY</span>
                            </div>
                            <div class="detail-item">
                                <label class="detail-label">Current Voucher Amount</label>
                                <span id="CurrentVoucherAmount" class="detail-value">
                                    Rp @machine.CURRENT_AMOUNT.ToString("N0", new CultureInfo("id-ID"))
                                </span>
                            </div>
                        </div>
                        <!-- Gambar -->
                        <div class="col-md-6 text-center">
                            <div id="MachineImageArea">
                                <img id="MachineImagePreview" class="img-thumbnail img-product" src="@Url.Content(machine.IMAGE_PATH ?? "~/img/liugongQcard.png")" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Program Detail Section -->
    <div id="divVoucherDetail" class="portlet light bordered">
        <div class="row">
            <div class="col-xs-6">
                <div class="page-head">
                    <div class="page-title">
                        <h1>
                            <span>Claim Voucher</span>
                        </h1>
                    </div>
                </div>
            </div>
        </div>
        <div class="portlet-body" style="padding-top:15px;">
            <div class="row">
                <div class="col-md-12">
                    <form id="PdcForm" method="post">
                        @Html.AntiForgeryToken()
                        <div class="inputs inputs-full-width col-md-6" style="padding: 0;">
                            <div class="row">
                                <div class="col-md-12">
                                    <div class="form-group">
                                        <label><b>Select PDC</b></label>
                                        <input id="PDC_ID" name="PDC_ID" type="text" class="form-control" />
                                        <span class="text-danger"></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        <div>
            <div class="row">
                <div class="col-md-12">
                    <div class="form-group">
                        <a class="btn blue trigger" id="btnAddPartClaim">
                            <i class="fa fa-plus"></i>Add Part
                        </a>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12">
                    <div class="form-group">
                        <table class="table table-bordered table-striped detail-table" id="tablePart">
                            <thead class="detail-table-header">
                                <tr>
                                    <th style="width: 5%;"><b>Action</b></th>
                                    <th style="width: 15%;"><b>Part No.</b></th>
                                    <th style="width: 20%;"><b>Description</b></th>
                                    <th style="width: 20%;"><b>Retail Price</b></th>
                                    <th style="width: 10%;"><b>Qty</b></th>
                                    <th style="width: 20%;"><b>Total</b></th>
                                    <th style="display:none;"><b>TotalDiscount</b></th>
                                </tr>
                            </thead>
                            <tbody>
                                <!-- Row akan ditambahkan via JavaScript -->
                            </tbody>
                            <tfoot>
                                <tr>
                                    <th colspan="5" style="text-align:right;"><b>Claim Amount</b></th>
                                    <th id="claimAmount" style="text-align:right;">Rp 0</th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="portlet light bordered" style="background-color:#f9f9f9;">
                    <div class="portlet-body">
                        <div class="row">
                            <div class="col-xs-12">
                                <div class="page-head">
                                    <div class="page-title">
                                        <h1>
                                            <span>Discount Calculation Preview</span>
                                        </h1>
                                    </div>
                                </div>
                            </div>
                            <div class="col-xs-12">
                                <small class="text-muted" style="font-style: italic; margin-top:0px; margin-bottom:10px;">
                                    *) This section is for preview only.
                                </small>
                            </div>
                        </div>
                        <br />
                        <div class="row">
                            <div class="col-md-5 text-right" style="justify-content:end; align-items:center;">
                                <label for="discountInput"><b>Discount (%)</b></label>
                            </div>
                            <div class="col-md-7">
                                <div class="form-group">
                                    <input type="number" id="discountInput" name="discountInput" class="form-control text-right" style="width: 100%;" />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-5 text-right" style="justify-content:end; align-items:center;">
                                <label for="claimAmountDiscount">Claim Amount (after discount)</label>
                            </div>
                            <div class="col-md-7">
                                <div class="form-group">
                                    <input type="text" id="claimAmountDiscount" name="claimAmountDiscount" class="form-control text-right" style="width: 100%;" disabled="disabled" />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-5 text-right" style="justify-content:end; align-items:center;">
                                <label for="PPNDiscount">PPN 11% (after discount)</label>
                            </div>
                            <div class="col-md-7">
                                <div class="form-group">
                                    <input type="text" id="PPNDiscount" name="PPNDiscount" class="form-control text-right" style="width: 100%;" disabled="disabled" />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-5 text-right" style="justify-content:end; align-items:center;">
                                <label for="grandTotalDiscount">Grand Total (after discount)</label>
                            </div>
                            <div class="col-md-7">
                                <div class="form-group">
                                    <input type="text" id="grandTotalDiscount" name="grandTotalDiscount" class="form-control text-right" style="width: 100%;" disabled="disabled" />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-5">
                                <div class="form-group text-right">
                                    <label for="reminingBalanceDiscount">Estimation Remaining Balance (after discount)</label>
                                </div>
                            </div>
                            <div class="col-md-7">
                                <div class="form-group">
                                    <input type="text" id="reminingBalanceDiscount" name="reminingBalanceDiscount" class="form-control text-right" style="width: 100%;" disabled="disabled" value="Rp @machine.CURRENT_AMOUNT.ToString("N0", new CultureInfo("id-ID"))" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div id ="claimSummary" class="claim-summary col-md-6">
                <div class="portlet light bordered">
                    <div class="portlet-body">
                        <div class="row">
                            <div class="col-xs-12">
                                <div class="page-head">
                                    <div class="page-title">
                                        <h1>
                                            <span>Claim Summary</span>
                                        </h1>
                                    </div>
                                </div>
                            </div>
                            <div class="col-xs-12">
                                <small class="text-muted" style="font-style: italic; margin-top:0px; margin-bottom:10px;">
                                    *) The amount of Remaining Balance could change after verification by LiuGong Administrator.
                                </small>
                            </div>
                        </div><br/>
                        <div class="row">
                            <div class="col-md-5 text-right" style="justify-content:end; align-items:center;">
                                <label for="PPN" class="mb-0">PPN 11%</label>
                            </div>
                            <div class="col-md-7">
                                <div class="form-group">
                                    <input type="text" id="PPN" name="PPN" class="form-control text-right" disabled />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-5 text-right" style="justify-content:end; align-items:center;">
                                <label for="grandTotal">Grand Total</label>
                            </div>
                            <div class="col-md-7">
                                <div class="form-group">
                                    <input type="text" id="grandTotal" name="grandTotal" class="form-control text-right" style="width: 100%;" disabled="disabled" />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-5 text-right" style="justify-content:end; align-items:center;">
                                <label for="reminingBalance">Estimation Remaining Balance</label>
                            </div>
                            <div class="col-md-7">
                                <div class="form-group">
                                    <input type="text" id="reminingBalance" name="reminingBalance" class="form-control text-right" style="width: 100%;" disabled="disabled" value="Rp @machine.CURRENT_AMOUNT.ToString("N0", new CultureInfo("id-ID"))" />
                                </div>
                            </div>
                        </div>
                        <div id="claimAction" class="claim-action">
                            <div class="row">
                                <div class="col-md-12 text-right">
                                    <div class="form-group">
                                        <a class="btn blue trigger" id="btnClaimVoucher">
                                            <i class="fa fa-paper-plane"></i> <span class="hidden-xs">Claim</span>
                                        </a>
                                        <a class="btn btn-reset clear-trigger" id="btnReset">
                                            <i class="fa fa-refresh"></i> <span class="hidden-xs">Reset</span>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .sticky-claim {
        position: fixed !important;
        bottom: 0 !important;
        left: 0 !important;
        right: 0 !important;
        background: white !important;
        padding: 15px !important;
        border-top: 2px solid #e7ecf1 !important;
        box-shadow: 0 -2px 20px rgba(0,0,0,0.15) !important;
        z-index: 1000 !important;
        margin: 0 !important;
        width: 100% !important;
    }

    .claim-summary-placeholder {
        visibility: hidden;
        opacity: 0;
        height: 0;
        transition: height 0.2s ease;
    }
</style>