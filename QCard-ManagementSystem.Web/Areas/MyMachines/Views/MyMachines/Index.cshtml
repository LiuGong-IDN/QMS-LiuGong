@using QCard.ManagementSystem.Domain.Modules.Core.ViewModel

@section scripts {
    @Html.Partial("~/Areas/MyMachines/Views/MyMachines/Script/_MyMachines.cshtml")
}

<div class="portlet light margin-bottom-0">
    <div class="row">
        <div class="col-xs-6">
            <div class="page-head">
                <div class="page-title">
                    <h1>
                        <span>My Machines</span>
                    </h1>
                </div>
            </div>
        </div>
    </div>
    <br />

    <div class="portlet light bordered">
        <div class="portlet-body">
            <form data-grid="MyMachinesGrid">
                @Html.AntiForgeryToken()
                <div class="inputs inputs-full-width">
                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label><b>Serial No.</b></label>
                                <input id="SERIAL_NO-FILTER" type="text" class="form-control text-uppercase no-space-input" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label><b>Product Model</b></label>
                                <input id="MODEL-FILTER" name="MODEL-FILTER" class="form-control" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label><b>Product Group</b></label>
                                <input id="MACHINE_TYPE-FILTER" name="MACHINE_TYPE-FILTER" class="form-control"/>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <text>
                                    @if (QCard.ManagementSystem.Service.Modules.Core.Service.FunctionService.HasPermission("MyMachines", Feature.SEARCH_FEATURE))
                                    {
                                        <a class="btn blue trigger" id="btnSearch">
                                            <i class="fa fa-search"></i> <span class="hidden-xs">Search</span>
                                        </a>
                                    }
                                    <a class="btn btn-reset clear-trigger" id="btnClear">
                                        <i class="fa fa-refresh"></i> <span class="hidden-xs">Reset</span>
                                    </a>
                                </text>
                                <text class="pull-right">
                                    @if (QCard.ManagementSystem.Service.Modules.Core.Service.FunctionService.HasPermission("MyMachines", Feature.DOWNLOAD_FEATURE))
                                    {
                                        @* <a class="btn btn-default blue trigger" id="btnDownloadList">
                                            <i class="fa fa-download"></i> <span class="hidden-xs">Download List</span>
                                        </a> *@
                                        <a class="btn btn-success" id="btnDownloadAll">
                                            <i class="fa fa-download"></i> <span class="hidden-xs">Download All</span>
                                        </a>
                                    }
                                </text>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
        @await Html.PartialAsync("~/Areas/MyMachines/Views/MyMachines/Grid/_MyMachinesGrid.cshtml")
    </div>

</div>