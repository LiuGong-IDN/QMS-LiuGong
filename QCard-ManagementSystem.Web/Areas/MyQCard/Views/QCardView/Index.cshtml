@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment _env
@section scripts {
    @Html.Partial("~/Areas/MyQCard/Views/QCardView/Script/_QCardView.cshtml")
}

<div class="portlet light margin-bottom-0">
    <div class="row">
        <div class="col-xs-6">
            <div class="page-head">
                <div class="page-title">
                    <h1>
                        <span>My Q-Card</span>
                    </h1>
                </div>
            </div>
        </div>
    </div>
    <br />

    <div class="portlet light bordered">
        <div class="portlet-body">
            @{
                // Path SVG depan
                var frontSvgPath = System.IO.Path.Combine(
                _env.WebRootPath,
                "img", "QCardImage", "QCard_Front_2.svg"
                );
                var frontSvgContent = System.IO.File.ReadAllText(frontSvgPath);

                // Path SVG belakang
                var backSvgPath = System.IO.Path.Combine(
                _env.WebRootPath,
                "img", "QCardImage", "QCard_Back.svg"
                );
                var backSvgContent = System.IO.File.ReadAllText(backSvgPath);
            }

            <div style="display: flex; justify-content: center; gap: 50px; flex-wrap: wrap;">
                <div style="width:45%;">
                    <div class="qcard-svg">
                        @Html.Raw(frontSvgContent)
                    </div>
                </div>
                <div style="width:45%;">
                    <div class="qcard-svg">
                        @Html.Raw(backSvgContent)
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

<style>
    @@font-face {
        font-family: 'OCR A Std';
        src: url('/fonts/OCR-A-Std.otf') format('opentype');
        font-weight: normal;
        font-style: normal;
    }

    .qcard-svg svg {
        width: 100%;
        height: auto;
        display: block;
        font-family: 'OCR A Std', monospace;
    }
</style>