@using Kendo.Mvc.UI;

<div id="ProgramDetailModal" class="modal fade bs-modal-lg" abindex="-1" data-backdrop="static" data-keyboard="false" role="dialog" aria-hidden="true" style="display: none;">
    <div class="modal-dialog modal-dialog-centered modal-lg" style="width: 1200px;">
        <div class="modal-content">
            <div class="modal-header">
                <h4 id="programDetailTitle" class="modal-title">Program Detail</h4>
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true"></button>
            </div>

            <div class="modal-body">
                @await Html.PartialAsync("~/Areas/MyQCard/Views/ClaimHistory/Grid/_ProgramDetailHistoryGrid.cshtml")
            </div>
        </div>
    </div>
</div>

<style>
    .k-grid .k-grid-content tr {
        background-color: white !important;
    }

    .k-filter-row > th:first-child, .k-grid tbody td:first-child, .k-grid tfoot td:first-child, .k-grid-header th.k-header:first-child {
        border-left-width: 1px !important;
    }
</style>